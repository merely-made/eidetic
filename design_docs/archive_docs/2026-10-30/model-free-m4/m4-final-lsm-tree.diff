+
+#[test]
+fn prepared_tree_iterator_keeps_descriptors_after_tree_drop() {
+    let dir = tempfile::tempdir().unwrap();
+    let tree = Config::new(dir.path()).open().unwrap();
+    tree.insert("alpha", "value", 0);
+    tree.flush_active_memtable(0).unwrap().unwrap();
