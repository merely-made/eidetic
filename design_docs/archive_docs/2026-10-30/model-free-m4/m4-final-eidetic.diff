+    );
+}
+#[test]
+fn model_free_source_queries_refuse_inapplicable_record_filters() {
+    let q = RecordQuery {
+        operation: RecordOperation::CountByProducer,
+        filters: RecordFilters {
+            entity: Some("missing".into()),
+            ..Default::default()
+        },
