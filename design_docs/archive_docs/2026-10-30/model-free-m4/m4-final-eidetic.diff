+    assert!(matches!(
+        evaluate(&s, &q, &RecordSettings::default()),
+        Err(ResearchError::Invalid(_))
+    ));
+}
+#[test]
+fn model_free_filters_joins_and_work_limits_use_explicit_identity() {
