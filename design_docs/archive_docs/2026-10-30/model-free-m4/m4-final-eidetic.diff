diff --git a/crates/eidetic-search/src/records/mod.rs b/crates/eidetic-search/src/records/mod.rs
new file mode 100644
index 0000000..ff40a76
--- /dev/null
+++ b/crates/eidetic-search/src/records/mod.rs
@@ -0,0 +1,199 @@
+// Copyright 2026 Mark Alan Boykin
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. SPDX-License-Identifier: MPL-2.0
+//! Deterministic evaluation of already-authorized, complete snapshots.
+use eidetic::models::recall::RecallSourceId;
+use eidetic::records::*;
+use std::collections::{BTreeMap, BTreeSet};
+use std::io::{self, Write};
+mod operations;
+mod output;
+
+struct Budget {
+    left: usize,
+}
+impl Write for Budget {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        self.left = self
+            .left
+            .checked_sub(buf.len())
+            .ok_or_else(|| io::Error::other("input limit"))?;
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+fn invalid(s: &str) -> ResearchError {
+    ResearchError::Invalid(s.into())
+}
+fn push(
+    rows: &mut Vec<RecordRow>,
+    row: RecordRow,
+    settings: &RecordSettings,
+    output: &mut Budget,
+) -> Result<(), ResearchError> {
+    if rows.len() >= settings.max_rows {
+        return Err(ResearchError::LimitExceeded);
+    }
+    output
+        .write_all(b",")
+        .map_err(|_| ResearchError::LimitExceeded)?;
+    serde_json::to_writer(output, &row).map_err(|_| ResearchError::LimitExceeded)?;
+    rows.push(row);
+    Ok(())
+}
+fn matches_source(s: &SourceRecord, f: &RecordFilters) -> bool {
+    f.source.as_ref().is_none_or(|v| v == &s.source)
+        && f.tag.as_ref().is_none_or(|v| s.tags.contains(v))
+}
+fn matches_record(r: &PropertyRecordV1, f: &RecordFilters, d: &PropertyDefinitionV1) -> bool {
+    f.source.as_ref().is_none_or(|v| v == r.evidence.source())
+        && f.entity.as_ref().is_none_or(|v| v == &r.entity)
+        && f.property.as_ref().is_none_or(|v| v == &r.property)
+        && f.schema_revision
+            .as_ref()
+            .is_none_or(|v| v == &r.schema_revision)
+        && f.status
+            .as_ref()
+            .is_none_or(|v| r.status.as_ref() == Some(v))
+        && f.unit.as_ref().is_none_or(|v| d.unit.as_ref() == Some(v))
+        && f.valid_time.as_ref().is_none_or(|v| {
+            r.valid_time
+                .as_ref()
+                .is_some_and(|t| t.start < v.end && v.start < t.end)
+        })
+}
+/// Evaluate frozen inputs. The host must check current admission before and after
+/// building the snapshot and again before presenting or reopening evidence.
+pub fn evaluate(
+    snapshot: &RecordSnapshot,
+    query: &RecordQuery,
+    settings: &RecordSettings,
+) -> Result<RecordResult, ResearchError> {
+    if snapshot.sources.len() > settings.max_sources
+        || snapshot.records.len() > settings.max_records
+        || snapshot.definitions.len() > settings.max_records
+        || snapshot.lifecycle.len() > settings.max_records
+    {
+        return Err(ResearchError::LimitExceeded);
+    }
+    let mut budget = Budget {
+        left: settings.max_input_bytes,
+    };
+    serde_json::to_writer(&mut budget, &(snapshot, query, settings))
+        .map_err(|_| ResearchError::LimitExceeded)?;
+    if !snapshot.complete || !snapshot.exclusions.is_empty() {
+        return Err(ResearchError::Incomplete);
+    }
+    if snapshot.scope_generation.trim().is_empty() {
+        return Err(invalid("missing scope generation"));
+    }
+    if let Some(interval) = &query.filters.valid_time {
+        interval.validate()?;
+    }
+    let f = &query.filters;
+    if matches!(
+        query.operation,
+        RecordOperation::SourceLookup
+            | RecordOperation::CountByProducer
+            | RecordOperation::SourceTimeline
+            | RecordOperation::TagMembership
+    ) && (f.entity.is_some()
+        || f.property.is_some()
+        || f.schema_revision.is_some()
+        || f.status.is_some()
+        || f.valid_time.is_some()
+        || f.unit.is_some())
+    {
+        return Err(ResearchError::Unsupported(
+            "record filters do not apply to source operations".into(),
+        ));
+    }
+    let mut sources = BTreeMap::new();
+    for s in &snapshot.sources {
+        if s.source.source.trim().is_empty()
+            || s.version.trim().is_empty()
+            || s.producer.trim().is_empty()
+            || s.tags
+                .iter()
+                .any(|t| t.owner.trim().is_empty() || t.concept.trim().is_empty())
+            || sources.insert(&s.source, s).is_some()
+        {
+            return Err(invalid("invalid or repeated source"));
+        }
+    }
+    let mut definitions = BTreeMap::new();
+    for d in &snapshot.definitions {
+        d.validate()?;
+        if definitions.insert((&d.id, &d.revision), d).is_some() {
+            return Err(invalid("repeated definition"));
+        }
+    }
+    let mut observations = BTreeMap::new();
+    for o in &snapshot.lifecycle {
+        if o.lifecycle_ref.trim().is_empty()
+            || observations.insert(&o.record_id, &o.state).is_some()
+        {
+            return Err(invalid("repeated lifecycle observation"));
+        }
+    }
+    let mut records = BTreeMap::new();
+    let mut validation = Budget {
+        left: settings.max_validation_bytes,
+    };
+    for r in &snapshot.records {
+        let d = definitions
+            .get(&(&r.property, &r.schema_revision))
+            .ok_or_else(|| invalid("missing definition"))?;
+        serde_json::to_writer(&mut validation, d).map_err(|_| ResearchError::LimitExceeded)?;
+        r.validate(d)?;
+        let source = sources
+            .get(r.evidence.source())
+            .ok_or(ResearchError::Denied)?;
+        if source.version != r.evidence.version() {
+            return Err(ResearchError::Unavailable);
+        }
+        match observations.get(&r.id) {
+            Some(LifecycleState::Active) => {}
+            Some(LifecycleState::Withdrawn) => return Err(ResearchError::Withdrawn),
+            Some(LifecycleState::Denied) => return Err(ResearchError::Denied),
+            Some(LifecycleState::Unavailable) => return Err(ResearchError::Unavailable),
+            None => return Err(invalid("missing lifecycle observation")),
+        }
+        if let Some(previous) = records.insert(&r.id, r) {
+            if previous != r {
+                return Err(invalid("conflicting assertion projection"));
+            }
+        }
+    }
+    if observations.keys().any(|id| !records.contains_key(id)) {
+        return Err(invalid("orphan lifecycle observation"));
+    }
+    let selected_sources: Vec<_> = sources
+        .values()
+        .copied()
+        .filter(|s| matches_source(s, &query.filters))
+        .collect();
+    let admitted: BTreeSet<_> = selected_sources.iter().map(|s| &s.source).collect();
+    let selected: Vec<_> = records
+        .values()
+        .copied()
+        .filter(|r| {
+            admitted.contains(r.evidence.source())
+                && matches_record(
+                    r,
+                    &query.filters,
+                    definitions[&(&r.property, &r.schema_revision)],
+                )
+        })
+        .collect();
+    let rows = operations::run(query, settings, &selected_sources, &selected, &definitions)?;
+    Ok(RecordResult {
+        operation_version: "eidetic.structured-records/v2".into(),
+        snapshot: snapshot.clone(),
+        query: query.clone(),
+        settings: settings.clone(),
+        rows,
+    })
+}
diff --git a/crates/eidetic-search/src/records/operations.rs b/crates/eidetic-search/src/records/operations.rs
new file mode 100644
index 0000000..fbd119c
--- /dev/null
+++ b/crates/eidetic-search/src/records/operations.rs
@@ -0,0 +1,355 @@
+use super::output::{Key, Numeric, Value, emit};
+use super::*;
+
+type Definitions<'a> = BTreeMap<(&'a String, &'a String), &'a PropertyDefinitionV1>;
+fn value_key(value: &PropertyValue) -> Result<String, ResearchError> {
+    match value {
+        PropertyValue::Timestamp(t) => Ok(format!("timestamp:{:020}", t.utc_seconds()?)),
+        _ => serde_json::to_string(value).map_err(|e| invalid(&e.to_string())),
+    }
+}
+fn relation(
+    a: &PropertyRecordV1,
+    b: &PropertyRecordV1,
+    d: &PropertyDefinitionV1,
+) -> Result<Comparison, ResearchError> {
+    if a.entity != b.entity
+        || a.property != b.property
+        || a.schema_revision != b.schema_revision
+        || a.context != b.context
+    {
+        return Ok(Comparison::Distinct);
+    }
+    if a.status.is_none()
+        || a.status != b.status
+        || a.valid_time.is_none()
+        || b.valid_time.is_none()
+    {
+        return Ok(Comparison::NonComparable);
+    }
+    let (x, y) = (
+        a.valid_time.as_ref().unwrap(),
+        b.valid_time.as_ref().unwrap(),
+    );
+    if x.start >= y.end || y.start >= x.end {
+        return Ok(Comparison::Distinct);
+    }
+    if let (PropertyValue::Decimal { scale: x, .. }, PropertyValue::Decimal { scale: y, .. }) =
+        (&a.value, &b.value)
+    {
+        if x != y {
+            return Ok(Comparison::NonComparable);
+        }
+    }
+    let equal = match (&a.value, &b.value) {
+        (PropertyValue::Timestamp(x), PropertyValue::Timestamp(y)) => {
+            x.utc_seconds()? == y.utc_seconds()?
+        }
+        (x, y) => x == y,
+    };
+    if equal {
+        Ok(Comparison::Equal)
+    } else if d.cardinality == Cardinality::Multiple {
+        Ok(Comparison::Distinct)
+    } else {
+        Ok(Comparison::Disagreement)
+    }
+}
+fn source_bytes(s: &RecallSourceId) -> Option<usize> {
+    s.source
+        .len()
+        .checked_add(s.owner.as_ref().map_or(0, String::len))?
+        .checked_add(s.node.as_ref().map_or(0, String::len))
+}
+fn value_bytes(value: &PropertyValue) -> usize {
+    match value {
+        PropertyValue::Text(v) => v.len(),
+        PropertyValue::Decimal { unit, .. } => unit.len(),
+        _ => 0,
+    }
+}
+fn charge_pair(
+    a: &PropertyRecordV1,
+    b: &PropertyRecordV1,
+    op: &RecordOperation,
+    remaining: &mut usize,
+) -> Result<(), ResearchError> {
+    let cost = match op {
+        RecordOperation::JoinEntity => a.entity.len().checked_add(b.entity.len()),
+        RecordOperation::JoinSource => source_bytes(a.evidence.source())
+            .and_then(|x| source_bytes(b.evidence.source()).and_then(|y| x.checked_add(y))),
+        RecordOperation::Compare => [a, b].iter().try_fold(0usize, |n, r| {
+            [
+                r.entity.len(),
+                r.property.len(),
+                r.schema_revision.len(),
+                r.context.len(),
+                r.status.as_ref().map_or(0, String::len),
+                value_bytes(&r.value),
+            ]
+            .into_iter()
+            .try_fold(n, usize::checked_add)
+        }),
+        _ => Some(0),
+    }
+    .ok_or(ResearchError::LimitExceeded)?;
+    *remaining = remaining
+        .checked_sub(cost)
+        .ok_or(ResearchError::LimitExceeded)?;
+    Ok(())
+}
+fn pair_work(n: usize, settings: &RecordSettings) -> Result<usize, ResearchError> {
+    let pairs = n
+        .checked_mul(n.saturating_sub(1))
+        .and_then(|x| x.checked_div(2))
+        .ok_or(ResearchError::LimitExceeded)?;
+    settings
+        .max_work
+        .checked_sub(pairs)
+        .ok_or(ResearchError::LimitExceeded)
+}
+fn source_refs<'a>(records: &[&'a PropertyRecordV1]) -> Vec<&'a RecallSourceId> {
+    records
+        .iter()
+        .map(|r| r.evidence.source())
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect()
+}
+pub(super) fn run(
+    query: &RecordQuery,
+    settings: &RecordSettings,
+    sources: &[&SourceRecord],
+    records: &[&PropertyRecordV1],
+    definitions: &Definitions<'_>,
+) -> Result<Vec<RecordRow>, ResearchError> {
+    let mut rows = Vec::new();
+    let mut output = Budget {
+        left: settings.max_output_bytes,
+    };
+    match query.operation {
+        RecordOperation::SourceLookup
+        | RecordOperation::SourceTimeline
+        | RecordOperation::TagMembership => {
+            if matches!(query.operation, RecordOperation::TagMembership)
+                && query.filters.tag.is_none()
+            {
+                return Err(invalid("tag identity required"));
+            }
+            for s in sources {
+                let key = if matches!(query.operation, RecordOperation::SourceTimeline) {
+                    Key::Time(s.captured_at)
+                } else {
+                    Key::Source(&s.source)
+                };
+                emit(
+                    &mut rows,
+                    key,
+                    None,
+                    None,
+                    &[],
+                    vec![&s.source],
+                    settings,
+                    &mut output,
+                )?;
+            }
+            if matches!(query.operation, RecordOperation::SourceTimeline) {
+                rows.sort_by(|a, b| {
+                    if let (RowValue::Time(x), RowValue::Time(y)) = (&a.key, &b.key) {
+                        x.cmp(y).then(a.sources.cmp(&b.sources))
+                    } else {
+                        std::cmp::Ordering::Equal
+                    }
+                });
+            }
+        }
+        RecordOperation::CountByProducer => {
+            let mut groups: BTreeMap<&str, Vec<&RecallSourceId>> = BTreeMap::new();
+            for s in sources {
+                if !groups.contains_key(s.producer.as_str()) && groups.len() >= settings.max_rows {
+                    return Err(ResearchError::LimitExceeded);
+                }
+                groups.entry(&s.producer).or_default().push(&s.source);
+            }
+            for (producer, refs) in groups {
+                emit(
+                    &mut rows,
+                    Key::Text(producer),
+                    None,
+                    Some(refs.len() as u64),
+                    &[],
+                    refs,
+                    settings,
+                    &mut output,
+                )?;
+            }
+        }
+        RecordOperation::CountBySource => {
+            let mut groups: BTreeMap<&RecallSourceId, Vec<&PropertyRecordV1>> = BTreeMap::new();
+            for r in records {
+                if !groups.contains_key(r.evidence.source()) && groups.len() >= settings.max_rows {
+                    return Err(ResearchError::LimitExceeded);
+                }
+                groups.entry(r.evidence.source()).or_default().push(r);
+            }
+            for (source, rs) in groups {
+                emit(
+                    &mut rows,
+                    Key::Source(source),
+                    None,
+                    Some(rs.len() as u64),
+                    &rs,
+                    vec![source],
+                    settings,
+                    &mut output,
+                )?;
+            }
+        }
+        RecordOperation::PropertyLookup | RecordOperation::RecordTimeline => {
+            for r in records {
+                let key = if matches!(query.operation, RecordOperation::RecordTimeline) {
+                    Key::Time(r.recorded_at)
+                } else {
+                    Key::Value(Value::Existing(&r.value))
+                };
+                emit(
+                    &mut rows,
+                    key,
+                    None,
+                    None,
+                    &[*r],
+                    vec![r.evidence.source()],
+                    settings,
+                    &mut output,
+                )?;
+            }
+            if matches!(query.operation, RecordOperation::RecordTimeline) {
+                rows.sort_by(|a, b| {
+                    if let (RowValue::Time(x), RowValue::Time(y)) = (&a.key, &b.key) {
+                        x.cmp(y).then(a.record_ids.cmp(&b.record_ids))
+                    } else {
+                        std::cmp::Ordering::Equal
+                    }
+                });
+            }
+        }
+        RecordOperation::GroupValues => {
+            let mut groups = BTreeMap::new();
+            for r in records {
+                let k = (
+                    &r.entity,
+                    &r.property,
+                    &r.schema_revision,
+                    &r.context,
+                    &r.status,
+                    &r.valid_time,
+                    value_key(&r.value)?,
+                );
+                if !groups.contains_key(&k) && groups.len() >= settings.max_rows {
+                    return Err(ResearchError::LimitExceeded);
+                }
+                groups.entry(k).or_insert_with(Vec::new).push(*r);
+            }
+            for rs in groups.values() {
+                let first = rs[0];
+                emit(
+                    &mut rows,
+                    Key::Value(Value::Existing(&first.value)),
+                    Some(first),
+                    None,
+                    rs,
+                    source_refs(rs),
+                    settings,
+                    &mut output,
+                )?;
+            }
+        }
+        RecordOperation::JoinEntity | RecordOperation::JoinSource | RecordOperation::Compare => {
+            let mut remaining = pair_work(records.len(), settings)?;
+            for (i, a) in records.iter().enumerate() {
+                for b in &records[i + 1..] {
+                    charge_pair(a, b, &query.operation, &mut remaining)?;
+                    let key = match query.operation {
+                        RecordOperation::JoinEntity if a.entity == b.entity => {
+                            Some(Key::Pair(&a.id, &b.id))
+                        }
+                        RecordOperation::JoinSource
+                            if a.evidence.source() == b.evidence.source() =>
+                        {
+                            Some(Key::Pair(&a.id, &b.id))
+                        }
+                        RecordOperation::Compare => Some(Key::Comparison(relation(
+                            a,
+                            b,
+                            definitions[&(&a.property, &a.schema_revision)],
+                        )?)),
+                        _ => None,
+                    };
+                    if let Some(key) = key {
+                        let pair = [*a, *b];
+                        emit(
+                            &mut rows,
+                            key,
+                            None,
+                            None,
+                            &pair,
+                            source_refs(&pair),
+                            settings,
+                            &mut output,
+                        )?;
+                    }
+                }
+            }
+        }
+        RecordOperation::Sum => {
+            if let Some(first) = records.first() {
+                let definition = definitions[&(&first.property, &first.schema_revision)];
+                let mut sum = 0i64;
+                for r in records {
+                    if r.property != first.property || r.schema_revision != first.schema_revision {
+                        return Err(invalid("sum requires one property schema"));
+                    }
+                    let value = match (&first.value, &r.value) {
+                        (PropertyValue::Integer(_), PropertyValue::Integer(v)) => *v,
+                        (
+                            PropertyValue::Decimal {
+                                scale: a, unit: u, ..
+                            },
+                            PropertyValue::Decimal {
+                                coefficient,
+                                scale: b,
+                                unit: v,
+                            },
+                        ) if a == b && u == v && definition.unit.as_ref() == Some(u) => {
+                            *coefficient
+                        }
+                        _ => {
+                            return Err(invalid("sum requires compatible numeric units and scale"));
+                        }
+                    };
+                    sum = sum.checked_add(value).ok_or(ResearchError::Overflow)?;
+                }
+                let value = match &first.value {
+                    PropertyValue::Integer(_) => Numeric::Integer(sum),
+                    PropertyValue::Decimal { scale, unit, .. } => Numeric::Decimal {
+                        coefficient: sum,
+                        scale: *scale,
+                        unit,
+                    },
+                    _ => unreachable!(),
+                };
+                emit(
+                    &mut rows,
+                    Key::Value(Value::Numeric(value)),
+                    None,
+                    None,
+                    records,
+                    source_refs(records),
+                    settings,
+                    &mut output,
+                )?;
+            }
+        }
+    }
+    Ok(rows)
+}
diff --git a/crates/eidetic-search/src/records/output.rs b/crates/eidetic-search/src/records/output.rs
new file mode 100644
index 0000000..0097984
--- /dev/null
+++ b/crates/eidetic-search/src/records/output.rs
@@ -0,0 +1,149 @@
+//! Borrowed row preflight, before materializing any output-owned strings.
+use super::*;
+use serde::{Serialize, Serializer, ser::SerializeSeq};
+
+#[derive(Serialize)]
+pub(super) enum Numeric<'a> {
+    Integer(i64),
+    Decimal {
+        coefficient: i64,
+        scale: u8,
+        unit: &'a str,
+    },
+}
+pub(super) enum Value<'a> {
+    Existing(&'a PropertyValue),
+    Numeric(Numeric<'a>),
+}
+impl Serialize for Value<'_> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Self::Existing(v) => v.serialize(serializer),
+            Self::Numeric(v) => v.serialize(serializer),
+        }
+    }
+}
+impl Value<'_> {
+    fn into_owned(self) -> PropertyValue {
+        match self {
+            Self::Existing(value) => value.clone(),
+            Self::Numeric(Numeric::Integer(v)) => PropertyValue::Integer(v),
+            Self::Numeric(Numeric::Decimal {
+                coefficient,
+                scale,
+                unit,
+            }) => PropertyValue::Decimal {
+                coefficient,
+                scale,
+                unit: unit.into(),
+            },
+        }
+    }
+}
+#[derive(Serialize)]
+pub(super) enum Key<'a> {
+    Source(&'a RecallSourceId),
+    Text(&'a str),
+    Time(Option<i64>),
+    Value(Value<'a>),
+    Comparison(Comparison),
+    Pair(&'a str, &'a str),
+}
+impl Key<'_> {
+    fn into_owned(self) -> RowValue {
+        match self {
+            Self::Source(v) => RowValue::Source(v.clone()),
+            Self::Text(v) => RowValue::Text(v.into()),
+            Self::Time(v) => RowValue::Time(v),
+            Self::Value(v) => RowValue::Value(v.into_owned()),
+            Self::Comparison(v) => RowValue::Comparison(v),
+            Self::Pair(a, b) => RowValue::Pair(a.into(), b.into()),
+        }
+    }
+}
+#[derive(Serialize)]
+struct Group<'a> {
+    entity: &'a str,
+    property: &'a str,
+    schema_revision: &'a str,
+    context: &'a str,
+    status: &'a Option<String>,
+    valid_time: &'a Option<TimeInterval>,
+    value: &'a PropertyValue,
+}
+impl<'a> From<&'a PropertyRecordV1> for Group<'a> {
+    fn from(r: &'a PropertyRecordV1) -> Self {
+        Self {
+            entity: &r.entity,
+            property: &r.property,
+            schema_revision: &r.schema_revision,
+            context: &r.context,
+            status: &r.status,
+            valid_time: &r.valid_time,
+            value: &r.value,
+        }
+    }
+}
+struct Ids<'a, 'b>(&'a [&'b PropertyRecordV1]);
+impl Serialize for Ids<'_, '_> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut seq = serializer.serialize_seq(Some(self.0.len()))?;
+        for record in self.0 {
+            seq.serialize_element(&record.id)?;
+        }
+        seq.end()
+    }
+}
+#[derive(Serialize)]
+struct RowView<'a, 'b> {
+    key: &'a Key<'b>,
+    group: Option<Group<'b>>,
+    count: Option<u64>,
+    record_ids: Ids<'a, 'b>,
+    sources: &'a [&'b RecallSourceId],
+}
+/// The serialized view has precisely RecordRow's shape, but borrows every
+/// potentially large field. A failed check never clones an output string.
+pub(super) fn emit<'a>(
+    rows: &mut Vec<RecordRow>,
+    key: Key<'a>,
+    group: Option<&'a PropertyRecordV1>,
+    count: Option<u64>,
+    records: &[&'a PropertyRecordV1],
+    sources: Vec<&'a RecallSourceId>,
+    settings: &RecordSettings,
+    output: &mut Budget,
+) -> Result<(), ResearchError> {
+    if rows.len() >= settings.max_rows {
+        return Err(ResearchError::LimitExceeded);
+    }
+    let view = RowView {
+        key: &key,
+        group: group.map(Group::from),
+        count,
+        record_ids: Ids(records),
+        sources: &sources,
+    };
+    let mut remaining = Budget { left: output.left };
+    remaining
+        .write_all(b",")
+        .map_err(|_| ResearchError::LimitExceeded)?;
+    serde_json::to_writer(&mut remaining, &view).map_err(|_| ResearchError::LimitExceeded)?;
+    let group = group.map(|r| PropertyGroupKey {
+        entity: r.entity.clone(),
+        property: r.property.clone(),
+        schema_revision: r.schema_revision.clone(),
+        context: r.context.clone(),
+        status: r.status.clone(),
+        valid_time: r.valid_time.clone(),
+        value: r.value.clone(),
+    });
+    let row = RecordRow {
+        key: key.into_owned(),
+        group,
+        count,
+        record_ids: records.iter().map(|r| r.id.clone()).collect(),
+        sources: sources.into_iter().cloned().collect(),
+    };
+    push(rows, row, settings, output)
+}
diff --git a/crates/eidetic-search/tests/model_free_records.rs b/crates/eidetic-search/tests/model_free_records.rs
