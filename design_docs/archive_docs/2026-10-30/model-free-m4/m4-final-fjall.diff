+            max_value_bytes: 4096,
+            max_key_bytes: 4096,
+            max_replay_bytes: 1_000_000,
+            max_replay_items: 1_000_000,
+            max_metadata_bytes: 128 * 1024 * 1024,
+            max_input_bytes: 256 * 1024 * 1024,
+            max_alloc_bytes: 256 * 1024 * 1024,
