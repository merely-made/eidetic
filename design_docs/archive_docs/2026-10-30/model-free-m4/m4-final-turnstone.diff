+        generation,
+        &|_| {
+            if fail {
+                Err(muniment::StoreError::Backend(
+                    "injected sync failure".into(),
+                ))
+            } else {
+                Ok(())
+            }
+        },
+    );
+    receive.recv().unwrap()
