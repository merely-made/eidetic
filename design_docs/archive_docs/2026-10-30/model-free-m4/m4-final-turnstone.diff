@@ -0,0 +1,237 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::App;
+use crate::research_records::{Job, JobResult};
+impl App {
+    pub(super) fn structured_response_current(&self, response: &JobResult) -> bool {
+        let (job, scope) = match response {
+            JobResult::Query { request, .. } => (Job::Query(request.clone()), &request.scope),
+            JobResult::Deposit { request, .. } => (Job::Deposit(request.clone()), &request.scope),
+            JobResult::Inspect {
+                id, scope, binding, ..
+            } => (
+                Job::Inspect {
+                    id: *id,
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                },
+                scope,
+            ),
+            JobResult::Replay { id, scope, .. } => {
+                let Some(Job::Replay { result, .. }) =
+                    self.research_search.structured.controller.pending.as_ref()
+                else {
+                    return false;
+                };
+                (
+                    Job::Replay {
+                        id: *id,
+                        scope: scope.clone(),
+                        result: *result,
+                    },
+                    scope,
+                )
+            },
+            JobResult::ConfirmProperty {
+                request,
+                scope,
+                binding,
+                ..
+            } => (
+                Job::ConfirmProperty {
+                    request: request.clone(),
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                },
+                scope,
+            ),
+            JobResult::ConfirmResult {
+                request,
+                scope,
+                binding,
+                value,
+                ..
+            } => (
+                Job::ConfirmResult {
+                    request: request.clone(),
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                    value: value.clone(),
+                },
+                scope,
+            ),
+            JobResult::MarkProperty {
+                request,
+                scope,
+                binding,
+                assertion,
+                ..
+            } => (
+                Job::MarkProperty {
+                    request: request.clone(),
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                    assertion: assertion.clone(),
+                },
+                scope,
+            ),
+            JobResult::MarkResult {
+                request,
+                scope,
+                binding,
+                assertion,
+                value,
+                ..
+            } => (
+                Job::MarkResult {
+                    request: request.clone(),
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                    assertion: assertion.clone(),
+                    value: value.clone(),
+                },
+                scope,
+            ),
+            JobResult::PrepareWithdrawal {
+                id,
+                scope,
+                binding,
+                nonce,
+                ..
+            } => (
+                Job::PrepareWithdrawal {
+                    id: *id,
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                    nonce: *nonce,
+                },
+                scope,
+            ),
+            JobResult::ConfirmWithdrawal {
+                id,
+                scope,
+                binding,
+                nonce,
+                ..
+            } => (
+                Job::ConfirmWithdrawal {
+                    id: *id,
+                    scope: scope.clone(),
+                    binding: binding.clone(),
+                    nonce: *nonce,
+                },
+                scope,
+            ),
+            JobResult::Recovery { id, scope, .. } => (
+                Job::Recovery {
+                    id: *id,
+                    scope: scope.clone(),
+                },
+                scope,
+            ),
+            JobResult::Reconcile {
+                id, scope, item, ..
+            } => (
+                Job::Reconcile {
+                    id: *id,
+                    scope: scope.clone(),
+                    item: item.clone(),
+                },
+                scope,
+            ),
+            JobResult::RecoveryMark {
+                id,
+                scope,
+                item,
+                binding,
+                assertion,
+                ..
+            } => (
+                Job::RecoveryMark {
+                    id: *id,
+                    scope: scope.clone(),
+                    item: item.clone(),
+                    binding: binding.clone(),
+                    assertion: assertion.clone(),
+                },
+                scope,
+            ),
+            JobResult::RecoveryAck {
+                id,
+                scope,
+                item,
+                binding,
+                ..
+            } => (
+                Job::RecoveryAck {
+                    id: *id,
+                    scope: scope.clone(),
+                    item: item.clone(),
+                    binding: binding.clone(),
+                },
+                scope,
+            ),
+            JobResult::Abandon {
+                id, scope, nonce, ..
+            } => (
+                Job::Abandon {
+                    id: *id,
+                    scope: scope.clone(),
+                    nonce: *nonce,
+                },
+                scope,
+            ),
+            JobResult::Discover {
+                id,
+                scope,
+                bindings,
+                history,
+                ..
+            } => (
+                Job::Discover {
+                    id: *id,
+                    scope: scope.clone(),
+                    bindings: bindings.clone(),
+                    history: *history,
+                },
+                scope,
+            ),
+            JobResult::OpenSource {
+                id,
+                scope,
+                generation,
+                source,
+                version,
+                ..
+            } => (
+                Job::OpenSource {
+                    id: *id,
+                    scope: scope.clone(),
+                    generation: *generation,
+                    source: source.clone(),
+                    version: version.clone(),
+                },
+                scope,
+            ),
+            JobResult::OpenEvidence {
+                id,
+                scope,
+                generation,
+                binding,
+                record,
+                ..
+            } => (
+                Job::OpenEvidence {
+                    id: *id,
+                    scope: scope.clone(),
+                    generation: *generation,
+                    binding: binding.clone(),
+                    record: record.clone(),
+                },
+                scope,
+            ),
+        };
+        self.research_search.structured.controller.pending.as_ref() == Some(&job)
+            && self.structured_scope_is_current(scope)
+    }
+}
diff --git a/src/app/research_record_scope.rs b/src/app/research_record_scope.rs
new file mode 100644
index 00000000..ed0446e1
--- /dev/null
+++ b/src/app/research_record_scope.rs
@@ -0,0 +1,173 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+//! Recheck previously enumerated scope without rebuilding its projections.
+use super::App;
+use crate::research_records::{Binding, ScopeToken};
+
+impl App {
+    pub(super) fn structured_scope(&self) -> Result<ScopeToken, String> {
+        self.structured_scope_reserved(0, 0)
+    }
+    pub(super) fn structured_scope_reserved(
+        &self,
+        work: usize,
+        bytes: usize,
+    ) -> Result<ScopeToken, String> {
+        let (context, revision) = self.research.context_revision()?;
+        if context.session != self.session_id {
+            return Err("Structured session changed".into());
+        }
+        let custody_epoch = (self.research.clip_access()?.epoch)()
+            .ok_or("Unlock the profile to use structured research")?;
+        let mut graphs = Vec::new();
+        let mut graph_instances = Vec::new();
+        let mut graph_manifests = Vec::new();
+        let mut owner_bindings = Vec::new();
+        let mut budget =
+            crate::research_record_graph::Budget::new(&self.research_search.preferences.records);
+        for runtime in self
+            .graph_runtimes
+            .iter()
+            .filter(|runtime| runtime.session == Some(self.session_id))
+        {
+            runtime
+                .persistence
+                .placement_for(&self.session_dir())
+                .map_err(|e| format!("Graph placement unavailable: {e}"))?;
+            for (_, node) in runtime.canvas.graph().nodes() {
+                budget.charge(1, 0, node.url().len())?;
+                crate::retained_clip::request(node.url())
+                    .map_err(|e| format!("Retained source is malformed: {e}"))?;
+            }
+            graphs.push((runtime.graph, runtime.canvas.graph().revision()));
+            graph_instances.push((runtime.graph, runtime.instance));
+            for binding in crate::research_record_graph::bindings_limited(
+                runtime.canvas.graph(),
+                true,
+                &mut budget,
+            )? {
+                graph_manifests.push((runtime.graph, binding.manifest));
+                owner_bindings.push(crate::research_records::OwnerBinding {
+                    binding: Binding {
+                        graph: runtime.graph,
+                        entity: binding.entity,
+                        statement_id: binding.statement_id,
+                        manifest: binding.manifest,
+                    },
+                    author: binding.author,
+                    withdrawn: binding.withdrawn,
+                });
+            }
+            for binding in crate::research_record_graph::result_bindings_limited(
+                runtime.canvas.graph(),
+                &mut budget,
+            )? {
+                graph_manifests.push((runtime.graph, binding.manifest));
+            }
+        }
+        budget.charge(work, 0, bytes)?;
+        graphs.sort_by_key(|(graph, _)| *graph.as_uuid());
+        graph_instances.sort_by_key(|(graph, _)| *graph.as_uuid());
+        graph_manifests.sort_by_key(|(graph, manifest)| (*graph.as_uuid(), manifest.to_string()));
+        owner_bindings.sort_by_key(|value| {
+            (
+                *value.binding.graph.as_uuid(),
+                value.binding.statement_id.clone(),
+            )
+        });
+        Ok(ScopeToken {
+            context,
+            revision,
+            custody_epoch,
+            graphs,
+            graph_instances,
+            selected: self.research_search.selected.clone(),
+            graph_manifests,
+            owner_bindings,
+            settings: self.research_search.preferences.records.clone(),
+        })
+    }
+
+    /// Identity-only recovery token: graph enumeration may itself exceed query limits.
+    pub(super) fn structured_recovery_scope(&self) -> Result<ScopeToken, String> {
+        let (context, revision) = self.research.context_revision()?;
+        if context.session != self.session_id {
+            return Err("Structured session changed".into());
+        }
+        let custody_epoch = (self.research.clip_access()?.epoch)()
+            .ok_or("Unlock the profile to use structured research")?;
+        let mut graphs = Vec::new();
+        let mut graph_instances = Vec::new();
+        for runtime in self
+            .graph_runtimes
+            .iter()
+            .filter(|runtime| runtime.session == Some(self.session_id))
+        {
+            runtime
+                .persistence
+                .placement_for(&self.session_dir())
+                .map_err(|e| format!("Graph placement unavailable: {e}"))?;
+            graphs.push((runtime.graph, runtime.canvas.graph().revision()));
+            graph_instances.push((runtime.graph, runtime.instance));
+        }
+        graphs.sort_by_key(|(graph, _)| *graph.as_uuid());
+        graph_instances.sort_by_key(|(graph, _)| *graph.as_uuid());
+        Ok(ScopeToken {
+            context,
+            revision,
+            custody_epoch,
+            graphs,
+            graph_instances,
+            selected: self.research_search.selected.clone(),
+            graph_manifests: vec![],
+            owner_bindings: vec![],
+            settings: self.research_search.preferences.records.clone(),
+        })
+    }
+    pub(super) fn clear_structured_index(&mut self) {
+        let state = &mut self.research_search.structured;
+        state.index = None;
+        state.indexed_generation = None;
+        state.index_error = None;
+    }
+    pub(super) fn clear_structured_projection(&mut self) {
+        self.research_search.structured.controller = Default::default();
+        self.clear_structured_index();
+    }
+    pub(super) fn structured_scope_is_current(&self, expected: &ScopeToken) -> bool {
+        if expected.context.session != self.session_id
+            || self.research.context_revision().ok()
+                != Some((expected.context.clone(), expected.revision))
+            || self
+                .research
+                .clip_access()
+                .ok()
+                .and_then(|access| (access.epoch)())
+                != Some(expected.custody_epoch)
+            || self.research_search.selected != expected.selected
+            || self.research_search.preferences.records != expected.settings
+        {
+            return false;
+        }
+        let mut graphs = Vec::new();
+        let mut instances = Vec::new();
+        for runtime in self
+            .graph_runtimes
+            .iter()
+            .filter(|runtime| runtime.session == Some(self.session_id))
+        {
+            if runtime
+                .persistence
+                .placement_for(&self.session_dir())
+                .is_err()
+            {
+                return false;
+            }
+            graphs.push((runtime.graph, runtime.canvas.graph().revision()));
+            instances.push((runtime.graph, runtime.instance));
+        }
+        graphs.sort_by_key(|(graph, _)| *graph.as_uuid());
+        instances.sort_by_key(|(graph, _)| *graph.as_uuid());
+        graphs == expected.graphs && instances == expected.graph_instances
+    }
+}
