+    let mut store = muniment::FjallStore::open(root.path()).unwrap();
+    let definition = PropertyDefinitionV1 {
+        id: "fixture.departure".into(),
+        revision: "1".into(),
+        value_type: ValueType::Text,
+        unit: None,
+        cardinality: Cardinality::Single,
+        statuses: vec!["approved".into()],
