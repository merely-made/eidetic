@@ -0,0 +1,106 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::super::research_structured_state::{
+    FrozenTarget,
+    index::{Entry, Index},
+};
+use super::{
+    Command,
+    format::{clipped, group_summary, item, page_nav, preview_value, row_value, source_id},
+};
+use crate::ui::Suggestion;
+use eidetic::records::{RecordResult, RowValue};
+fn preview(row: &RowValue) -> String {
+    match row {
+        RowValue::Text(s) => clipped(s, 160),
+        RowValue::Value(v) => preview_value(v, 160),
+        RowValue::Pair(a, b) => format!("{} ↔ {}", clipped(a, 80), clipped(b, 80)),
+        _ => clipped(&row_value(row), 160),
+    }
+}
+pub(super) fn result_rows(
+    rows: &mut Vec<Suggestion>,
+    result: &RecordResult,
+    index: &Index,
+    page: usize,
+    size: usize,
+) {
+    let start = page.saturating_mul(size);
+    let end = start.saturating_add(size).min(index.total());
+    for position in start..end {
+        let Some(entry) = index.locate(position) else {
+            break;
+        };
+        let row_index = match entry {
+            Entry::Row(i) => i,
+            Entry::Record { row, .. } | Entry::Source { row, .. } => row,
+        };
+        let row = &result.rows[row_index];
+        match entry {
+            Entry::Row(_) => {
+                let mut label = preview(&row.key);
+                if let Some(count) = row.count {
+                    label.push_str(&format!(" · count {count}"));
+                }
+                if let Some(source) = row.sources.first() {
+                    label.push_str(&format!(" · source {}", source_id(source)));
+                    if row.sources.len() > 1 {
+                        label.push_str(&format!(" · {} sources", row.sources.len()));
+                    }
+                }
+                if let Some(group) = &row.group {
+                    label.push_str(&format!(" · {}", group_summary(group)));
+                }
+                item(
+                    rows,
+                    label,
+                    if row.group.is_some() {
+                        Command::Group {
+                            generation: index.generation,
+                            index: row_index,
+                        }
+                    } else if row.sources.len() == 1 {
+                        Command::RowSource {
+                            generation: index.generation,
+                            row: row_index,
+                            source: 0,
+                        }
+                    } else {
+                        Command::Home
+                    },
+                );
+            },
+            Entry::Record { record, .. } => {
+                let id = &row.record_ids[record];
+                match index.record_index(id) {
+                    Some(i) => item(
+                        rows,
+                        format!("Inspect record {}", clipped(id, 100)),
+                        Command::Frozen {
+                            generation: Some(index.generation),
+                            target: FrozenTarget::Record(i),
+                        },
+                    ),
+                    None => item(
+                        rows,
+                        format!("Record {} unavailable or ambiguous", clipped(id, 100)),
+                        Command::Home,
+                    ),
+                }
+            },
+            Entry::Source { source, .. } => item(
+                rows,
+                format!(
+                    "Inspect contributing source {}",
+                    source_id(&row.sources[source])
+                ),
+                Command::RowSource {
+                    generation: index.generation,
+                    row: row_index,
+                    source,
+                },
+            ),
+        }
+    }
+    page_nav(rows, page, size, index.total());
+}
diff --git a/src/app/research_structured_rows.rs b/src/app/research_structured_rows.rs
new file mode 100644
index 00000000..a3182ab5
--- /dev/null
+++ b/src/app/research_structured_rows.rs
@@ -0,0 +1,600 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::{
+    App,
+    research_structured_state::{Command, View},
+};
+use eidetic::records::{Cardinality, RecordOperation, ValueType};
+
+#[path = "research_structured_format.rs"]
+pub(super) mod format;
+#[path = "research_structured_result_rows.rs"]
+mod result_rows;
+#[path = "research_structured_snapshot.rs"]
+mod snapshot;
+#[path = "research_structured_snapshot_rows.rs"]
+mod snapshot_rows;
+use format::{clipped, field, group_rows, item, operation, page_nav, source_id};
+impl App {
+    pub(crate) fn research_structured_rows(&mut self, row_limit: usize) {
+        {
+            let state = &mut self.research_search.structured;
+            let generation = state.controller.result_generation;
+            if state.indexed_generation != generation {
+                state.index = None;
+                state.index_error = None;
+                state.indexed_generation = generation;
+                if let (Some(generation), Some(result)) =
+                    (generation, state.controller.result.as_ref())
+                {
+                    match super::research_structured_state::index::Index::new(
+                        generation,
+                        &result.rows,
+                        &result.snapshot.sources,
+                        &result.snapshot.records,
+                    ) {
+                        Ok(index) => state.index = Some(index),
+                        Err(error) => state.index_error = Some(error),
+                    }
+                }
+                state.page = 0;
+                if matches!(
+                    state.view,
+                    View::Frozen { .. }
+                        | View::FrozenPart { .. }
+                        | View::RowSource { .. }
+                        | View::Group { .. }
+                        | View::GroupPart { .. }
+                        | View::InputList(_)
+                ) {
+                    state.view = View::Home;
+                }
+            }
+        }
+        let state = &self.research_search.structured;
+        let mut rows = vec![];
+        let size = self
+            .research_search
+            .preferences
+            .settings
+            .limit
+            .clamp(1, 100);
+        let start = state.page.saturating_mul(size);
+        if let Some(error) = state.error.as_ref().or(state.controller.error.as_ref()) {
+            item(
+                &mut rows,
+                format!("Unavailable: {}", clipped(error, 160)),
+                Command::Home,
+            );
+        }
+        if let Some(error) = &state.index_error {
+            item(
+                &mut rows,
+                format!("Result navigation unavailable: {}", clipped(error, 160)),
+                Command::Home,
+            );
+        }
+        if state.controller.busy {
+            item(&mut rows, "Working…", Command::Home);
+        }
+        match &state.view {
+            View::Home => {
+                item(
+                    &mut rows,
+                    format!("Operation: {}", operation(&state.operation)),
+                    Command::Operations,
+                );
+                format::home_scope(&mut rows, &self.research_search.selected);
+                item(&mut rows, "Filters…", Command::Filters);
+                item(&mut rows, "Run in this scope", Command::Run);
+                item(&mut rows, "Enter a sourced property…", Command::Author);
+                item(&mut rows, "Saved results and replay…", Command::Saved);
+                item(&mut rows, "Withdrawn record history…", Command::History);
+                item(&mut rows, "Pending saves…", Command::Recovery);
+                item(&mut rows, "Operation limits…", Command::Settings);
+                if let Some(result) = &state.controller.result {
+                    item(
+                        &mut rows,
+                        format!(
+                            "{} · {} · {} inputs · {} records",
+                            format::result_operation(
+                                &result.query.operation,
+                                state.controller.result_historical
+                            ),
+                            if result.snapshot.complete {
+                                "complete"
+                            } else {
+                                "incomplete"
+                            },
+                            result.snapshot.sources.len(),
+                            result.snapshot.records.len()
+                        ),
+                        Command::Home,
+                    );
+                    for exclusion in result.snapshot.exclusions.iter().take(10) {
+                        item(
+                            &mut rows,
+                            format!("Excluded: {}", clipped(exclusion, 160)),
+                            Command::Home,
+                        );
+                    }
+                    if result.snapshot.complete && result.rows.is_empty() {
+                        item(
+                            &mut rows,
+                            "No matching records in this scope",
+                            Command::Home,
+                        );
+                    }
+                    item(
+                        &mut rows,
+                        "Inspect exact query inputs and lifecycle…",
+                        Command::Inputs,
+                    );
+                    let page_size = self
+                        .research_search
+                        .preferences
+                        .settings
+                        .limit
+                        .clamp(1, 100);
+                    if let Some(index) = &state.index {
+                        result_rows::result_rows(&mut rows, result, index, state.page, page_size);
+                    }
+                }
+                if let Some((_, record)) = &state.controller.inspected {
+                    item(
+                        &mut rows,
+                        format!("Inspect record {}", clipped(&record.id, 100)),
+                        Command::Frozen {
+                            generation: None,
+                            target: super::research_structured_state::FrozenTarget::Inspected,
+                        },
+                    );
+                }
+
+                item(&mut rows, "Back to search", Command::Back);
+            },
+            View::Inputs => snapshot_rows::input_menu(&mut rows),
+            View::InputList(kind) => {
+                if let (Some(result), Some(index)) = (&state.controller.result, &state.index) {
+                    snapshot_rows::input_list(
+                        &mut rows,
+                        result,
+                        index.generation,
+                        *kind,
+                        state.page,
+                        size,
+                    );
+                }
+            },
+            View::RowSource {
+                generation,
+                row,
+                source,
+            } => {
+                if let (Some(result), Some(index)) = (&state.controller.result, &state.index) {
+                    snapshot_rows::row_source(
+                        &mut rows,
+                        result,
+                        index,
+                        *generation,
+                        *row,
+                        *source,
+                        state.page,
+                        size,
+                    );
+                }
+            },
+            View::Frozen { generation, target } => snapshot_rows::frozen_fields(
+                &mut rows,
+                &state.controller,
+                *generation,
+                *target,
+                state.page,
+                size,
+            ),
+            View::FrozenPart {
+                generation,
+                target,
+                field,
+                start,
+            } => snapshot_rows::frozen_part(
+                &mut rows,
+                &state.controller,
+                *generation,
+                *target,
+                *field,
+                *start,
+            ),
+            View::Group { generation, index } => {
+                if let Some(group) = state
+                    .controller
+                    .result
+                    .as_ref()
+                    .and_then(|r| r.rows.get(*index))
+                    .and_then(|row| row.group.as_ref())
+                {
+                    group_rows(&mut rows, group, *generation, *index);
+                }
+                item(&mut rows, "Back to results", Command::Home);
+            },
+            View::GroupPart {
+                generation,
+                index,
+                field,
+                start,
+            } => {
+                if let Some(group) = state
+                    .controller
+                    .result
+                    .as_ref()
+                    .and_then(|r| r.rows.get(*index))
+                    .and_then(|r| r.group.as_ref())
+                {
+                    format::group_part_rows(&mut rows, group, *generation, *index, *field, *start);
+                }
+                item(
+                    &mut rows,
+                    "Back to group",
+                    Command::Group {
+                        generation: *generation,
+                        index: *index,
+                    },
+                );
+            },
+            View::Recovery => format::recovery_rows(
+                &mut rows,
+                state
+                    .controller
+                    .recovery
+                    .iter()
+                    .map(|p| (p.nonce, p.kind.as_str(), p.status.as_str(), p.orphan)),
+                state.page,
+                size,
+                state.controller.recovery.len(),
+            ),
+            View::Operations => {
+                for op in [
+                    RecordOperation::SourceLookup,
+                    RecordOperation::CountByProducer,
+                    RecordOperation::CountBySource,
+                    RecordOperation::SourceTimeline,
+                    RecordOperation::RecordTimeline,
+                    RecordOperation::TagMembership,
+                    RecordOperation::PropertyLookup,
+                    RecordOperation::GroupValues,
+                    RecordOperation::JoinEntity,
+                    RecordOperation::JoinSource,
+                    RecordOperation::Compare,
+                    RecordOperation::Sum,
+                ] {
+                    item(&mut rows, operation(&op), Command::Operation(op));
+                }
+                item(&mut rows, "Back", Command::Home);
+            },
+            View::Filters => {
+                let f = &state.filters;
+                item(
+                    &mut rows,
+                    format!(
+                        "Source: {}",
+                        f.source
+                            .as_ref()
+                            .map(source_id)
+                            .unwrap_or_else(|| "any".into())
+                    ),
+                    Command::FilterSources,
+                );
+                field(
+                    &mut rows,
+                    "Entity ID",
+                    f.entity.as_deref().unwrap_or(""),
+                    "filter_entity",
+                );
+                field(
+                    &mut rows,
+                    "Property ID",
+                    f.property.as_deref().unwrap_or(""),
+                    "filter_property",
+                );
+                field(
+                    &mut rows,
+                    "Schema revision",
+                    f.schema_revision.as_deref().unwrap_or(""),
+                    "filter_revision",
+                );
+                field(
+                    &mut rows,
+                    "Status",
+                    f.status.as_deref().unwrap_or(""),
+                    "filter_status",
+                );
+                field(
+                    &mut rows,
+                    "Unit",
+                    f.unit.as_deref().unwrap_or(""),
+                    "filter_unit",
+                );
+                field(
+                    &mut rows,
+                    "Tag owner|concept",
+                    &f.tag
+                        .as_ref()
+                        .map(|t| format!("{}|{}", clipped(&t.owner, 80), clipped(&t.concept, 80)))
+                        .unwrap_or_default(),
+                    "filter_tag",
+                );
+                field(&mut rows, "Valid from", &state.filter_start, "filter_start");
+                field(
+                    &mut rows,
+                    "Valid until (exclusive)",
+                    &state.filter_end,
+                    "filter_end",
+                );
+                item(&mut rows, "Back", Command::Home);
+            },
+            View::FilterSources => {
+                item(&mut rows, "Any source", Command::FilterSource(None));
+                if let Some(result) = &self.research_search.result {
+                    for source in result.inputs.iter().skip(start).take(size) {
+                        item(
+                            &mut rows,
+                            format!(
+                                "{} · {}",
+                                clipped(source.title.as_deref().unwrap_or("Untitled"), 100),
+                                source_id(&source.source)
+                            ),
+                            Command::FilterSource(Some(source.source.clone())),
+                        );
+                    }
+                    page_nav(&mut rows, state.page, size, result.inputs.len());
+                }
+                item(&mut rows, "Back", Command::Filters);
+            },
+            View::Author => {
+                let d = &state.draft;
+                item(
+                    &mut rows,
+                    format!(
+                        "Existing entity: {}",
+                        d.entity
+                            .map(|(_, id)| id.to_string())
+                            .unwrap_or_else(|| "choose".into())
+                    ),
+                    Command::Entities,
+                );
+                field(
+                    &mut rows,
+                    "Namespaced property ID",
+                    &d.definition,
+                    "definition",
+                );
+                field(&mut rows, "Schema revision", &d.revision, "revision");
+                item(&mut rows, "Value type:", Command::Author);
+                for (kind, label) in [
+                    (ValueType::Text, "Text"),
+                    (ValueType::Boolean, "Boolean"),
+                    (ValueType::Integer, "Integer"),
+                    (ValueType::Decimal, "Decimal"),
+                    (ValueType::CivilDate, "Date"),
+                    (ValueType::Timestamp, "Timestamp"),
+                ] {
+                    item(
+                        &mut rows,
+                        format!(
+                            "{} {label}",
+                            if d.value_type.as_ref() == Some(&kind) {
+                                "✓"
+                            } else {
+                                "○"
+                            }
+                        ),
+                        Command::Type(kind),
+                    );
+                }
+                for (v, label) in [
+                    (Cardinality::Single, "Single value"),
+                    (Cardinality::Multiple, "Multiple values"),
+                ] {
+                    item(
+                        &mut rows,
+                        format!(
+                            "{} {label}",
+                            if d.cardinality.as_ref() == Some(&v) {
+                                "✓"
+                            } else {
+                                "○"
+                            }
+                        ),
+                        Command::Cardinality(v),
+                    );
+                }
+                field(&mut rows, "Unit", &d.unit, "unit");
+                field(
+                    &mut rows,
+                    "Allowed statuses (comma separated)",
+                    &d.statuses,
+                    "statuses",
+                );
+                field(&mut rows, "Value", &d.value, "value");
+                field(&mut rows, "Context", &d.context, "context");
+                field(
+                    &mut rows,
+                    "Status (empty means unknown)",
+                    &d.status,
+                    "status",
+                );
+                field(&mut rows, "Valid from", &d.valid_start, "valid_start");
+                field(
+                    &mut rows,
+                    "Valid until (exclusive)",
+                    &d.valid_end,
+                    "valid_end",
+                );
+                item(
+                    &mut rows,
+                    format!(
+                        "Exact evidence: {}",
+                        d.evidence
+                            .as_ref()
+                            .map(|t| match t {
+                                crate::research::Target::Capture(t) =>
+                                    clipped(&t.key.annotation_manifest, 100),
+                                crate::research::Target::Clip(t) =>
+                                    clipped(&t.clip.manifest.to_string(), 100),
+                            })
+                            .unwrap_or_else(|| "choose a search passage".into())
+                    ),
+                    Command::Evidence,
+                );
+                item(
+                    &mut rows,
+                    "Author: current profile identity · method: manual",
+                    Command::Author,
+                );
+                item(&mut rows, "Save sourced property", Command::SaveProperty);
+                item(&mut rows, "Back", Command::Home);
+            },
+            View::Entities => {
+                match self.structured_entities() {
+                    Ok(choices) => {
+                        let total = choices.len();
+                        for choice in choices.into_iter().skip(start).take(size) {
+                            item(
+                                &mut rows,
+                                format!("{} · {}", clipped(&choice.label, 100), choice.entity),
+                                Command::Entity(choice.graph, choice.entity),
+                            );
+                        }
+                        page_nav(&mut rows, state.page, size, total);
+                    },
+                    Err(error) => item(
+                        &mut rows,
+                        format!("Entities unavailable: {}", clipped(&error, 160)),
+                        Command::Author,
+                    ),
+                }
+                item(&mut rows, "Back", Command::Author);
+            },
+            View::Evidence => {
+                if let Some(result) = &self.research_search.result {
+                    let total = result.hits.len();
+                    for hit in result.hits.iter().skip(start).take(size) {
+                        if let (Ok(mut target), Some(passage)) = (
+                            crate::research::target(&hit.source, &hit.version),
+                            &hit.passage,
+                        ) {
+                            target.set_selector(crate::saved_sources::Selector {
+                                start: passage.selector.start,
+                                end: passage.selector.end,
+                            });
+                            item(
+                                &mut rows,
+                                format!(
+                                    "{} · {} · version {} · {}..{} · {}",
+                                    clipped(hit.title.as_deref().unwrap_or("Untitled"), 100),
+                                    source_id(&hit.source),
+                                    clipped(&hit.version, 100),
+                                    passage.selector.start,
+                                    passage.selector.end,
+                                    clipped(
+                                        &passage.text,
+                                        self.research_search
+                                            .preferences
+                                            .settings
+                                            .snippet_context
+                                            .clamp(1, 200)
+                                    )
+                                ),
+                                Command::EvidenceTarget(target),
+                            );
+                        }
+                    }
+                    page_nav(&mut rows, state.page, size, total);
+                }
+                item(
+                    &mut rows,
+                    "Search for a passage first; each choice preserves its exact version and scalar range",
+                    Command::Author,
+                );
+                item(&mut rows, "Back", Command::Author);
+            },
+            View::Settings => format::settings_rows(
+                &mut rows,
+                &self.research_search.preferences.records,
+                &self.research_search.preferences.storage,
+                self.research.storage_limits().ok().as_ref(),
+            ),
+            View::Saved => {
+                match self.structured_saved_results() {
+                    Ok(choices) => {
+                        let total = choices.len();
+                        for choice in choices.into_iter().skip(start).take(size) {
+                            item(
+                                &mut rows,
+                                format!("Replay saved result {}", choice.binding.manifest),
+                                Command::Replay(choice.binding.manifest),
+                            );
+                        }
+                        page_nav(&mut rows, state.page, size, total);
+                    },
+                    Err(error) => item(
+                        &mut rows,
+                        format!("Saved results unavailable: {}", clipped(&error, 160)),
+                        Command::Home,
+                    ),
+                }
+                item(&mut rows, "Back", Command::Home);
+            },
+            View::History => {
+                match self.structured_history() {
+                    Ok(choices) => {
+                        let total = choices.len();
+                        for binding in choices.into_iter().skip(start).take(size) {
+                            item(
+                                &mut rows,
+                                format!(
+                                    "Inspect withdrawn assertion {}",
+                                    clipped(&binding.statement_id, 100)
+                                ),
+                                Command::Inspect(binding),
+                            );
+                        }
+                        page_nav(&mut rows, state.page, size, total);
+                    },
+                    Err(error) => item(
+                        &mut rows,
+                        format!("History unavailable: {}", clipped(&error, 160)),
+                        Command::Home,
+                    ),
+                }
+                item(&mut rows, "Back", Command::Home);
+            },
+            View::Input(field) => {
+                let prompt = if field.contains("start") || field.contains("end") {
+                    "Enter YYYY-MM-DDTHH:MM:SS with Z or ±HH:MM; leave both bounds empty for unknown"
+                } else if field == "value" {
+                    "Enter the typed value; timestamps require an explicit offset"
+                } else {
+                    "Enter a value; empty clears"
+                };
+                item(
+                    &mut rows,
+                    prompt,
+                    Command::Submit(self.omnibar.text.clone()),
+                );
+            },
+        }
+        let start = self
+            .research_search
+            .first_row
+            .min(rows.len().saturating_sub(1));
+        self.omnibar.suggestions = rows
+            .iter()
+            .skip(start)
+            .take(row_limit.max(1))
+            .cloned()
+            .collect();
+        self.omnibar.selected = 0;
+        self.research_search.rows = rows;
+    }
+}
diff --git a/src/app/research_structured_snapshot.rs b/src/app/research_structured_snapshot.rs
new file mode 100644
index 00000000..a39c55ee
--- /dev/null
+++ b/src/app/research_structured_snapshot.rs
@@ -0,0 +1,301 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+//! Read-only views over the accepted frozen payload; never grants evidence access.
+use super::super::research_structured_state::FrozenTarget;
+use eidetic::records::{
+    Evidence, PropertyDefinitionV1, PropertyRecordV1, PropertyValue, RecordResult,
+};
+use std::borrow::Cow;
+#[cfg(test)]
+#[path = "research_structured_snapshot_tests.rs"]
+mod tests;
+type Field<'a> = (&'static str, Cow<'a, str>);
+fn optional(value: Option<&str>) -> Cow<'_, str> {
+    Cow::Borrowed(value.unwrap_or("unknown"))
+}
+fn number(value: impl std::fmt::Display) -> Cow<'static, str> {
+    Cow::Owned(value.to_string())
+}
+fn value_field(value: &PropertyValue, field: usize) -> Option<Field<'_>> {
+    Some(match (value, field) {
+        (PropertyValue::Text(v), 0) => ("Value", Cow::Borrowed(v)),
+        (PropertyValue::Boolean(v), 0) => ("Value", number(v)),
+        (PropertyValue::Integer(v), 0) => ("Value", number(v)),
+        (PropertyValue::Decimal { coefficient, .. }, 0) => {
+            ("Decimal coefficient", number(coefficient))
+        },
+        (PropertyValue::Decimal { scale, .. }, 1) => ("Decimal scale", number(scale)),
+        (PropertyValue::Decimal { unit, .. }, 2) => ("Unit", Cow::Borrowed(unit)),
+        (PropertyValue::CivilDate(d), 0) => (
+            "Date",
+            Cow::Owned(format!("{:04}-{:02}-{:02}", d.year, d.month, d.day)),
+        ),
+        (PropertyValue::Timestamp(t), 0) => (
+            "Timestamp",
+            Cow::Owned(format!(
+                "{:04}-{:02}-{:02}T{:02}:{:02}:{:02} offset {} minutes",
+                t.date.year, t.date.month, t.date.day, t.hour, t.minute, t.second, t.offset_minutes
+            )),
+        ),
+        _ => return None,
+    })
+}
+fn source_field(
+    source: &eidetic::models::recall::RecallSourceId,
+    field: usize,
+) -> Option<Field<'_>> {
+    Some(match field {
+        0 => ("Source kind", Cow::Owned(format!("{:?}", source.kind))),
+        1 => ("Source owner", optional(source.owner.as_deref())),
+        2 => ("Source ID", Cow::Borrowed(&source.source)),
+        3 => ("Source node", optional(source.node.as_deref())),
+        _ => return None,
+    })
+}
+pub(super) fn record_field(record: &PropertyRecordV1, field: usize) -> Option<Field<'_>> {
+    Some(match field {
+        0 => ("Record ID", Cow::Borrowed(&record.id)),
+        1 => ("Entity ID", Cow::Borrowed(&record.entity)),
+        2 => ("Property ID", Cow::Borrowed(&record.property)),
+        3 => ("Schema revision", Cow::Borrowed(&record.schema_revision)),
+        4 => ("Definition manifest", number(record.definition_manifest)),
+        5 => ("Context", Cow::Borrowed(&record.context)),
+        6..=8 => return value_field(&record.value, field - 6),
+        9 => ("Status", optional(record.status.as_deref())),
+        10 => (
+            "Valid from",
+            record
+                .valid_time
+                .as_ref()
+                .map(|t| number(t.start))
+                .unwrap_or_else(|| optional(None)),
+        ),
+        11 => (
+            "Valid until (exclusive)",
+            record
+                .valid_time
+                .as_ref()
+                .map(|t| number(t.end))
+                .unwrap_or_else(|| optional(None)),
+        ),
+        12 => ("Author", Cow::Borrowed(&record.author)),
+        13 => ("Method", Cow::Borrowed(&record.method)),
+        14 => (
+            "Recorded at",
+            record
+                .recorded_at
+                .map(number)
+                .unwrap_or_else(|| optional(None)),
+        ),
+        15..=18 => return source_field(record.evidence.source(), field - 15),
+        19 => ("Evidence version", Cow::Borrowed(record.evidence.version())),
+        20 => match &record.evidence {
+            Evidence::Passage { hash, .. } => ("Evidence hash", number(hash)),
+            Evidence::Field { record_id, .. } => ("Evidence record ID", Cow::Borrowed(record_id)),
+        },
+        21 => match &record.evidence {
+            Evidence::Passage { selector, .. } => ("Passage start", number(selector.start)),
+            Evidence::Field { field, .. } => ("Evidence field", Cow::Borrowed(field)),
+        },
+        22 => match &record.evidence {
+            Evidence::Passage { selector, .. } => ("Passage end", number(selector.end)),
+            Evidence::Field { .. } => return None,
+        },
+        _ => return None,
+    })
+}
+pub(super) fn definition_field(
+    definition: &PropertyDefinitionV1,
+    field: usize,
+) -> Option<Field<'_>> {
+    Some(match field {
+        0 => ("Property ID", Cow::Borrowed(&definition.id)),
+        1 => ("Schema revision", Cow::Borrowed(&definition.revision)),
+        2 => (
+            "Value type",
+            Cow::Owned(format!("{:?}", definition.value_type)),
+        ),
+        3 => ("Unit", optional(definition.unit.as_deref())),
+        4 => (
+            "Cardinality",
+            Cow::Owned(format!("{:?}", definition.cardinality)),
+        ),
+        n => (
+            "Allowed status",
+            Cow::Borrowed(definition.statuses.get(n - 5)?),
+        ),
+    })
+}
+pub(super) fn field_count(
+    result: Option<&RecordResult>,
+    inspected: Option<&PropertyRecordV1>,
+    target: FrozenTarget,
+) -> usize {
+    match target {
+        FrozenTarget::Inspected => inspected.map(|_| 23).unwrap_or(0),
+        FrozenTarget::Source(i) => result
+            .and_then(|r| r.snapshot.sources.get(i))
+            .map(|s| 7usize.saturating_add(s.tags.len().saturating_mul(2)))
+            .unwrap_or(0),
+        FrozenTarget::Record(i) => result
+            .and_then(|r| r.snapshot.records.get(i))
+            .map(|_| 23)
+            .unwrap_or(0),
+        FrozenTarget::Definition(i) => result
+            .and_then(|r| r.snapshot.definitions.get(i))
+            .map(|d| 5usize.saturating_add(d.statuses.len()))
+            .unwrap_or(0),
+        FrozenTarget::Lifecycle(i) => result
+            .and_then(|r| r.snapshot.lifecycle.get(i))
+            .map(|_| 3)
+            .unwrap_or(0),
+        FrozenTarget::Exclusion(i) => result
+            .and_then(|r| r.snapshot.exclusions.get(i))
+            .map(|_| 1)
+            .unwrap_or(0),
+        FrozenTarget::Query => result.map(|_| 23).unwrap_or(0),
+    }
+}
+pub(super) fn field<'a>(
+    result: Option<&'a RecordResult>,
+    inspected: Option<&'a PropertyRecordV1>,
+    target: FrozenTarget,
+    index: usize,
+) -> Option<Field<'a>> {
+    if target == FrozenTarget::Inspected {
+        return record_field(inspected?, index);
+    }
+    let result = result?;
+    match target {
+        FrozenTarget::Source(i) => {
+            let s = result.snapshot.sources.get(i)?;
+            match index {
+                0..=3 => source_field(&s.source, index),
+                4 => Some(("Version", Cow::Borrowed(&s.version))),
+                5 => Some(("Producer", Cow::Borrowed(&s.producer))),
+                6 => Some((
+                    "Captured at",
+                    s.captured_at.map(number).unwrap_or_else(|| optional(None)),
+                )),
+                n => {
+                    let t = s.tags.get((n - 7) / 2)?;
+                    if (n - 7) % 2 == 0 {
+                        Some(("Tag owner", Cow::Borrowed(&t.owner)))
+                    } else {
+                        Some(("Tag concept", Cow::Borrowed(&t.concept)))
+                    }
+                },
+            }
+        },
+        FrozenTarget::Record(i) => record_field(result.snapshot.records.get(i)?, index),
+        FrozenTarget::Definition(i) => definition_field(result.snapshot.definitions.get(i)?, index),
+        FrozenTarget::Lifecycle(i) => {
+            let l = result.snapshot.lifecycle.get(i)?;
+            match index {
+                0 => Some(("Record ID", Cow::Borrowed(&l.record_id))),
+                1 => Some(("Lifecycle reference", Cow::Borrowed(&l.lifecycle_ref))),
+                2 => Some(("Lifecycle state", Cow::Owned(format!("{:?}", l.state)))),
+                _ => None,
+            }
+        },
+        FrozenTarget::Exclusion(i) => {
+            if index == 0 {
+                Some((
+                    "Exclusion",
+                    Cow::Borrowed(result.snapshot.exclusions.get(i)?.as_str()),
+                ))
+            } else {
+                None
+            }
+        },
+        FrozenTarget::Query => query_field(result, index),
+        FrozenTarget::Inspected => None,
+    }
+}
+fn query_field(result: &RecordResult, index: usize) -> Option<Field<'_>> {
+    let f = &result.query.filters;
+    let s = &result.settings;
+    Some(match index {
+        0 => (
+            "Operation",
+            Cow::Owned(format!("{:?}", result.query.operation)),
+        ),
+        1 => (
+            "Operation version",
+            Cow::Borrowed(&result.operation_version),
+        ),
+        2 => (
+            "Scope generation",
+            Cow::Borrowed(&result.snapshot.scope_generation),
+        ),
+        3 => ("Entity filter", optional(f.entity.as_deref())),
+        4 => ("Property filter", optional(f.property.as_deref())),
+        5 => (
+            "Schema revision filter",
+            optional(f.schema_revision.as_deref()),
+        ),
+        6 => ("Status filter", optional(f.status.as_deref())),
+        7 => ("Unit filter", optional(f.unit.as_deref())),
+        8..=11 => {
+            return f
+                .source
+                .as_ref()
+                .and_then(|source| source_field(source, index - 8))
+                .or(Some(("Source filter", optional(None))));
+        },
+        12 => (
+            "Tag owner filter",
+            optional(f.tag.as_ref().map(|t| t.owner.as_str())),
+        ),
+        13 => (
+            "Tag concept filter",
+            optional(f.tag.as_ref().map(|t| t.concept.as_str())),
+        ),
+        14 => (
+            "Valid from filter",
+            f.valid_time
+                .as_ref()
+                .map(|v| number(v.start))
+                .unwrap_or_else(|| optional(None)),
+        ),
+        15 => (
+            "Valid until filter",
+            f.valid_time
+                .as_ref()
+                .map(|v| number(v.end))
+                .unwrap_or_else(|| optional(None)),
+        ),
+        16 => ("Source limit", number(s.max_sources)),
+        17 => ("Record limit", number(s.max_records)),
+        18 => ("Work limit", number(s.max_work)),
+        19 => ("Validation byte limit", number(s.max_validation_bytes)),
+        20 => ("Row limit", number(s.max_rows)),
+        21 => ("Input byte limit", number(s.max_input_bytes)),
+        22 => ("Output byte limit", number(s.max_output_bytes)),
+        _ => return None,
+    })
+}
+/// A bounded Unicode chunk and direct next/previous byte offsets.
+pub(super) fn part(text: &str, start: usize) -> Option<(&str, Option<usize>, Option<usize>)> {
+    if start > text.len() || !text.is_char_boundary(start) {
+        return None;
+    }
+    let end = text[start..]
+        .char_indices()
+        .nth(200)
+        .map(|(i, _)| start + i)
+        .unwrap_or(text.len());
+    let previous = (start > 0).then(|| {
+        text[..start]
+            .char_indices()
+            .rev()
+            .nth(199)
+            .map(|(i, _)| i)
+            .unwrap_or(0)
+    });
+    Some((
+        &text[start..end],
+        (end < text.len()).then_some(end),
+        previous,
+    ))
+}
diff --git a/src/app/research_structured_snapshot_rows.rs b/src/app/research_structured_snapshot_rows.rs
new file mode 100644
index 00000000..5068aeb9
--- /dev/null
+++ b/src/app/research_structured_snapshot_rows.rs
@@ -0,0 +1,311 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::super::{
+    research_record_owner::Controller,
+    research_structured_state::{FrozenTarget, InputKind, index::Index},
+};
+use super::{
+    Command,
+    format::{clipped, item, page_nav, source_id},
+    snapshot,
+};
+use crate::ui::Suggestion;
+use eidetic::records::RecordResult;
+#[cfg(test)]
+#[path = "research_structured_snapshot_rows_tests.rs"]
+mod tests;
+
+pub(super) fn input_menu(rows: &mut Vec<Suggestion>) {
+    for (label, kind) in [
+        ("Sources", InputKind::Sources),
+        ("Records", InputKind::Records),
+        ("Definitions", InputKind::Definitions),
+        ("Lifecycle observations", InputKind::Lifecycle),
+        ("Exclusions", InputKind::Exclusions),
+        ("Query and settings", InputKind::Query),
+    ] {
+        item(rows, label, Command::InputList(kind));
+    }
+    item(rows, "Back to results", Command::Home);
+}
+pub(super) fn input_list(
+    rows: &mut Vec<Suggestion>,
+    result: &RecordResult,
+    generation: uuid::Uuid,
+    kind: InputKind,
+    page: usize,
+    size: usize,
+) {
+    if kind == InputKind::Query {
+        item(
+            rows,
+            "Inspect exact query and settings",
+            Command::Frozen {
+                generation: Some(generation),
+                target: FrozenTarget::Query,
+            },
+        );
+        item(rows, "Back", Command::Inputs);
+        return;
+    }
+    let total = match kind {
+        InputKind::Sources => result.snapshot.sources.len(),
+        InputKind::Records => result.snapshot.records.len(),
+        InputKind::Definitions => result.snapshot.definitions.len(),
+        InputKind::Lifecycle => result.snapshot.lifecycle.len(),
+        InputKind::Exclusions => result.snapshot.exclusions.len(),
+        InputKind::Query => 0,
+    };
+    let start = page.saturating_mul(size);
+    for index in start..start.saturating_add(size).min(total) {
+        let (label, target) = match kind {
+            InputKind::Sources => {
+                let s = &result.snapshot.sources[index];
+                (
+                    format!(
+                        "Source {} · version {}",
+                        source_id(&s.source),
+                        clipped(&s.version, 80)
+                    ),
+                    FrozenTarget::Source(index),
+                )
+            },
+            InputKind::Records => {
+                let r = &result.snapshot.records[index];
+                (
+                    format!(
+                        "Record {} · entity {} · property {}",
+                        clipped(&r.id, 80),
+                        clipped(&r.entity, 80),
+                        clipped(&r.property, 80)
+                    ),
+                    FrozenTarget::Record(index),
+                )
+            },
+            InputKind::Definitions => {
+                let d = &result.snapshot.definitions[index];
+                (
+                    format!(
+                        "Definition {} · revision {}",
+                        clipped(&d.id, 100),
+                        clipped(&d.revision, 60)
+                    ),
+                    FrozenTarget::Definition(index),
+                )
+            },
+            InputKind::Lifecycle => {
+                let l = &result.snapshot.lifecycle[index];
+                (
+                    format!("Lifecycle {} · {:?}", clipped(&l.record_id, 100), l.state),
+                    FrozenTarget::Lifecycle(index),
+                )
+            },
+            InputKind::Exclusions => (
+                format!(
+                    "Exclusion {}",
+                    clipped(&result.snapshot.exclusions[index], 160)
+                ),
+                FrozenTarget::Exclusion(index),
+            ),
+            InputKind::Query => unreachable!(),
+        };
+        item(
+            rows,
+            label,
+            Command::Frozen {
+                generation: Some(generation),
+                target,
+            },
+        );
+    }
+    page_nav(rows, page, size, total);
+    item(rows, "Back", Command::Inputs);
+}
+pub(super) fn row_source(
+    rows: &mut Vec<Suggestion>,
+    result: &RecordResult,
+    index: &Index,
+    generation: uuid::Uuid,
+    row: usize,
+    source: usize,
+    page: usize,
+    size: usize,
+) {
+    if index.generation != generation {
+        return;
+    }
+    let Some(id) = result.rows.get(row).and_then(|r| r.sources.get(source)) else {
+        return;
+    };
+    item(
+        rows,
+        format!("Contributing source {}", source_id(id)),
+        Command::Home,
+    );
+    let versions = index.source_versions(id);
+    if versions.is_empty() {
+        item(
+            rows,
+            "Exact source version unavailable in frozen inputs",
+            Command::Home,
+        );
+    }
+    for &source_index in versions.iter().skip(page.saturating_mul(size)).take(size) {
+        let s = &result.snapshot.sources[source_index];
+        item(
+            rows,
+            format!("Inspect version {}", clipped(&s.version, 120)),
+            Command::Frozen {
+                generation: Some(generation),
+                target: FrozenTarget::Source(source_index),
+            },
+        );
+    }
+    page_nav(rows, page, size, versions.len());
+    item(rows, "Back to results", Command::Home);
+}
+fn record(controller: &Controller) -> Option<&eidetic::records::PropertyRecordV1> {
+    controller.inspected.as_ref().map(|(_, r)| r)
+}
+pub(super) fn frozen_fields(
+    rows: &mut Vec<Suggestion>,
+    controller: &Controller,
+    generation: Option<uuid::Uuid>,
+    target: FrozenTarget,
+    page: usize,
+    size: usize,
+) {
+    let total = snapshot::field_count(controller.result.as_ref(), record(controller), target);
+    let start = page.saturating_mul(size);
+    for field in start..start.saturating_add(size).min(total) {
+        if let Some((label, text)) = snapshot::field(
+            controller.result.as_ref(),
+            record(controller),
+            target,
+            field,
+        ) {
+            item(
+                rows,
+                format!("{label}: {}", clipped(&text, 160)),
+                Command::FrozenPart {
+                    generation,
+                    target,
+                    field,
+                    start: 0,
+                },
+            );
+        }
+    }
+    page_nav(rows, page, size, total);
+    match (generation, target) {
+        (Some(generation), FrozenTarget::Source(source)) => item(
+            rows,
+            "Open exact retained source",
+            Command::OpenResultSource { generation, source },
+        ),
+        (Some(generation), FrozenTarget::Record(record)) => {
+            item(
+                rows,
+                "Open exact record evidence",
+                Command::OpenFrozenEvidence { generation, record },
+            );
+            item(
+                rows,
+                "Inspect current assertion",
+                Command::InspectCurrentAssertion { generation, record },
+            );
+        },
+        (None, FrozenTarget::Inspected) => {
+            if let Some((binding, _)) = &controller.inspected {
+                item(
+                    rows,
+                    match controller.inspected_withdrawn {
+                        Some(false) => "Current assertion: active",
+                        Some(true) => "Current assertion: withdrawn",
+                        None => "Current assertion: state unavailable",
+                    },
+                    Command::Home,
+                );
+                item(
+                    rows,
+                    "Open exact record evidence",
+                    Command::OpenEvidence(binding.clone()),
+                );
+                if controller.inspected_withdrawn == Some(false) {
+                    item(
+                        rows,
+                        "Withdraw this assertion",
+                        Command::Withdraw(binding.clone()),
+                    );
+                }
+            }
+        },
+        _ => {},
+    }
+    item(
+        rows,
+        "Back",
+        if target == FrozenTarget::Inspected {
+            Command::Home
+        } else {
+            Command::Inputs
+        },
+    );
+}
+pub(super) fn frozen_part(
+    rows: &mut Vec<Suggestion>,
+    controller: &Controller,
+    generation: Option<uuid::Uuid>,
+    target: FrozenTarget,
+    field: usize,
+    start: usize,
+) {
+    if let Some((label, text)) = snapshot::field(
+        controller.result.as_ref(),
+        record(controller),
+        target,
+        field,
+    ) {
+        if let Some((piece, next, previous)) = snapshot::part(&text, start) {
+            item(
+                rows,
+                format!("{label}: {piece}"),
+                Command::FrozenPart {
+                    generation,
+                    target,
+                    field,
+                    start,
+                },
+            );
+            if let Some(start) = previous {
+                item(
+                    rows,
+                    "Previous part",
+                    Command::FrozenPart {
+                        generation,
+                        target,
+                        field,
+                        start,
+                    },
+                );
+            }
+            if let Some(start) = next {
+                item(
+                    rows,
+                    "Next part",
+                    Command::FrozenPart {
+                        generation,
+                        target,
+                        field,
+                        start,
+                    },
+                );
+            }
+        }
+    }
+    item(
+        rows,
+        "Back to fields",
+        Command::Frozen { generation, target },
+    );
+}
