index 00000000..a6c9d54e
--- /dev/null
+++ b/src/app/research_record_boundary_tests.rs
@@ -0,0 +1,112 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::*;
+
+fn fixture() -> (tempfile::TempDir, App, crate::panes::GraphId, uuid::Uuid) {
+    let root = tempfile::tempdir().unwrap();
+    let mut app = App::test_stub_at(root.path().to_path_buf());
+    let custody = crate::trail_memory::custody_test_fixture::custody();
+    app.research.set_available(true);
+    app.research.access(Some(crate::research::ClipAccess {
+        root: root.path().into(),
+        sealer: custody.sealer,
+        epoch: custody.epoch,
+    }));
+    app.sync_research_context();
+    let graph = app.graph_runtimes.active_graph();
+    let node = app.graph_runtimes.visit("https://fixture.test/entity");
+    let entity = app.graph_runtimes.graph().shown_resource_id(node).unwrap();
+    (root, app, graph, entity)
+}
+
+pub(super) fn smallest_scope_limit(app: &mut App, work: bool) -> usize {
+    let mut low = 0;
+    let mut high = if work {
+        app.research_search.preferences.records.max_work
+    } else {
+        app.research_search.preferences.records.max_input_bytes
+    };
+    while low < high {
+        let mid = low + (high - low) / 2;
+        if work {
+            app.research_search.preferences.records.max_work = mid;
+        } else {
+            app.research_search.preferences.records.max_input_bytes = mid;
+        }
+        if app.structured_scope().is_ok() {
+            high = mid;
+        } else {
+            low = mid + 1;
+        }
+    }
+    if work {
+        app.research_search.preferences.records.max_work = low;
+    } else {
+        app.research_search.preferences.records.max_input_bytes = low;
+    }
+    low
+}
+
+#[test]
+fn model_free_attachment_preflight_preserves_work_and_metadata_boundaries() {
+    for result in [false, true] {
+        for work in [false, true] {
+            let (_root, mut app, graph, entity) = fixture();
+            let author = app.structured_author_identity().unwrap().asserter_iri();
+            let manifest = eidetic::ManifestId::of_blob(b"candidate");
+            let (reserve_work, reserve_bytes) =
+                crate::research_record_graph::attachment_reservation(result, &author, manifest);
+            let minimum = smallest_scope_limit(&mut app, work);
+            if work {
+                app.research_search.preferences.records.max_work = minimum + reserve_work - 1;
+            } else {
+                app.research_search.preferences.records.max_input_bytes =
+                    minimum + reserve_bytes - 1;
+            }
+            let before = app.graph_runtimes.graph().revision();
+            assert!(app.structured_scope().is_ok());
+            assert!(
+                app.structured_attach_binding(graph, entity, manifest, result, &author)
+                    .is_err()
+            );
+            assert_eq!(app.graph_runtimes.graph().revision(), before);
+            if work {
+                app.research_search.preferences.records.max_work = minimum + reserve_work;
+            } else {
+                app.research_search.preferences.records.max_input_bytes = minimum + reserve_bytes;
+            }
+            app.structured_attach_binding(graph, entity, manifest, result, &author)
+                .unwrap();
+            assert!(app.structured_scope().is_ok());
+        }
+    }
+}
+
+#[test]
+fn model_free_recovery_inventory_available_after_unrelated_graph_growth() {
+    let (_root, mut app, graph, _entity) = fixture();
+    let minimum = smallest_scope_limit(&mut app, true);
+    app.research_search.preferences.records.max_work = minimum;
+    assert!(app.structured_scope().is_ok());
+    app.graph_runtimes
+        .get_mut(graph)
+        .unwrap()
+        .canvas
+        .ingest_graph(|graph| {
+            mere::kernel::graph::apply::add_node(
+                graph,
+                Some(uuid::Uuid::new_v4()),
+                "https://fixture.test/later".into(),
+                Default::default(),
+            );
+            true
+        });
+    assert!(app.structured_scope().is_err());
+    let effects = app.structured_refresh_recovery();
+    assert!(
+        effects
+            .iter()
+            .any(|effect| matches!(effect, Effect::ResearchRecords(Job::Recovery { .. })))
+    );
+    assert!(app.research_search.structured.controller.error.is_none());
+}
diff --git a/src/app/research_record_commit.rs b/src/app/research_record_commit.rs
new file mode 100644
index 00000000..abbfc91b
--- /dev/null
+++ b/src/app/research_record_commit.rs
@@ -0,0 +1,364 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+//! Live graph assertion writes and the existing session snapshot boundary.
+use super::App;
+use crate::research_record_graph::{self, GraphBinding};
+use crate::research_records::Binding;
+use mere::kernel::graph::Author;
+
+impl App {
+    pub(super) fn structured_check_assertion_author(
+        &self,
+        assertion: &serde_json::Value,
+    ) -> Result<(), String> {
+        let current = self.structured_author_identity()?.asserter_iri();
+        if assertion
+            .get("provenance_iri")
+            .and_then(|value| value.as_str())
+            != Some(current.as_str())
+        {
+            return Err("Profile identity changed before graph save".into());
+        }
+        Ok(())
+    }
+    pub(super) fn structured_author_identity(&self) -> Result<Author, String> {
+        let identity = self
+            .identity
+            .as_ref()
+            .ok_or("Unlock the profile to author a property")?;
+        let key = identity::IdentityProvider::master_public_key(identity.as_ref()).to_bytes();
+        let encoded: String = key.iter().map(|byte| format!("{byte:02x}")).collect();
+        Ok(Author::person(format!("personae:{encoded}")))
+    }
+    pub(super) fn structured_attach_binding(
+        &mut self,
+        graph_id: crate::panes::GraphId,
+        entity: uuid::Uuid,
+        manifest: eidetic::ManifestId,
+        result_binding: bool,
+        expected_author: &str,
+    ) -> Result<(Binding, serde_json::Value), String> {
+        let author = self.structured_author_identity()?;
+        if author.asserter_iri() != expected_author {
+            return Err("Profile identity changed before property commit".into());
+        }
+        let (work, bytes) = research_record_graph::attachment_reservation(
+            result_binding,
+            expected_author,
+            manifest,
+        );
+        self.structured_scope_reserved(work, bytes)?;
+        self.journal
+            .lock()
+            .map_err(|_| "Graph journal unavailable")?
+            .execution_error()
+            .map_or(Ok(()), |e| Err(e.to_string()))?;
+        let directory = self.session_dir();
+        let guard = crate::host_journal::AuthorRestore::enter(self.journal.clone(), author.clone());
+        let runtime = self
+            .graph_runtimes
+            .get_mut(graph_id)
+            .ok_or("Property graph unavailable")?;
+        if runtime.session != Some(self.session_id)
+            || !runtime.persistence.owns_directory(&directory)
+            || runtime.canvas.graph().resource(entity).is_none()
+        {
+            return Err("Property graph or writer lease changed".into());
+        }
+        let mut outcome: Result<GraphBinding, String> =
+            Err("Property graph mutation did not run".into());
+        runtime.canvas.ingest_graph(|graph| {
+            outcome = graph.write_as(author, |graph| {
+                if result_binding {
+                    research_record_graph::attach_result(graph, entity, manifest)
+                } else {
+                    research_record_graph::attach(graph, entity, manifest)
+                }
+            });
+            outcome.is_ok()
+        });
+        let binding = outcome?;
+        drop(guard);
+        self.journal
+            .lock()
+            .map_err(|_| "Graph journal unavailable")?
+            .execution_error()
+            .map_or(Ok(()), |e| Err(e.to_string()))?;
+        let assertion = research_record_graph::assertion_for(runtime.canvas.graph(), &binding)?;
+        Ok((
+            Binding {
+                graph: graph_id,
+                entity: binding.entity,
+                statement_id: binding.statement_id,
+                manifest: binding.manifest,
+            },
+            assertion,
+        ))
+    }
+    pub(super) fn structured_save_graph(
+        &self,
+        graph_id: crate::panes::GraphId,
+    ) -> Result<(), String> {
+        let directory = self.session_dir();
+        let runtime = self
+            .graph_runtimes
+            .get(graph_id)
+            .ok_or("Property graph unavailable")?;
+        if runtime.session != Some(self.session_id)
+            || !runtime.persistence.owns_directory(&directory)
+        {
+            return Err("Property writer lease changed".into());
+        }
+        runtime
+            .persistence
+            .save_graph_with(
+                &directory,
+                runtime.canvas.graph(),
+                || pandect::save_node_facets(&directory, runtime.canvas.graph().facets()),
+                |placement| {
+                    crate::session_graph_file::save_profiled(
+                        &directory.join(pandect::session_graph_store::GRAPH_FILE),
+                        runtime.canvas.graph(),
+                        placement,
+                    )
+                },
+            )
+            .map_err(|e| format!("Property snapshot save failed; recovery is required: {e}"))
+    }
+    pub(super) fn structured_assertion_matches(
+        &self,
+        binding: &Binding,
+        assertion: &serde_json::Value,
+        result: bool,
+    ) -> Result<(), String> {
+        let runtime = self
+            .graph_runtimes
+            .get(binding.graph)
+            .ok_or("Property graph unavailable")?;
+        let graph = runtime.canvas.graph();
+        let candidates = if result {
+            research_record_graph::result_bindings(graph)?
+        } else {
+            research_record_graph::bindings(graph, false)?
+        };
+        let held = candidates
+            .into_iter()
+            .find(|held| {
+                held.entity == binding.entity
+                    && held.statement_id == binding.statement_id
+                    && held.manifest == binding.manifest
+            })
+            .ok_or("Property assertion changed before save")?;
+        if research_record_graph::assertion_for(graph, &held)? != *assertion {
+            return Err("Property assertion changed before save".into());
+        }
+        Ok(())
+    }
+    pub(super) fn structured_commit_withdrawal(&mut self, binding: &Binding) -> Result<(), String> {
+        let author = self.structured_author_identity()?;
+        self.journal
+            .lock()
+            .map_err(|_| "Graph journal unavailable")?
+            .execution_error()
+            .map_or(Ok(()), |error| Err(error.to_string()))?;
+        let directory = self.session_dir();
+        let guard = crate::host_journal::AuthorRestore::enter(self.journal.clone(), author.clone());
+        let runtime = self
+            .graph_runtimes
+            .get_mut(binding.graph)
+            .ok_or("Property graph unavailable")?;
+        if runtime.session != Some(self.session_id)
+            || !runtime.persistence.owns_directory(&directory)
+        {
+            return Err("Property graph or writer lease changed".into());
+        }
+        let mut outcome = Err("Property withdrawal did not run".to_owned());
+        runtime.canvas.ingest_graph(|graph| {
+            outcome = graph.write_as(author, |graph| {
+                research_record_graph::withdraw_owned(graph, &binding.statement_id)
+            });
+            outcome.as_ref().copied().unwrap_or(false)
+        });
+        let changed = outcome?;
+        drop(guard);
+        self.journal
+            .lock()
+            .map_err(|_| "Graph journal unavailable")?
+            .execution_error()
+            .map_or(Ok(()), |error| Err(error.to_string()))?;
+        if !changed {
+            return Err("Property was already withdrawn".into());
+        }
+        runtime
+            .persistence
+            .save_graph_with(
+                &directory,
+                runtime.canvas.graph(),
+                || pandect::save_node_facets(&directory, runtime.canvas.graph().facets()),
+                |placement| {
+                    crate::session_graph_file::save_profiled(
+                        &directory.join(pandect::session_graph_store::GRAPH_FILE),
+                        runtime.canvas.graph(),
+                        placement,
+                    )
+                },
+            )
+            .map_err(|e| format!("Withdrawal snapshot save failed; recovery is required: {e}"))?;
+        Ok(())
+    }
+}
+
+impl App {
+    pub(super) fn structured_recover_assertion(
+        &mut self,
+        item: &crate::trail_memory::record_actor::RecoveryItem,
+    ) -> Result<(Binding, serde_json::Value, bool), String> {
+        use crate::trail_memory::record_actor::RecoveryItem;
+        let author = self.structured_author_identity()?;
+        let author_iri = author.asserter_iri();
+        let (session, graph_id, entity, manifest, statement, assertion, result_kind, withdrawing) =
+            match item {
+                RecoveryItem::Property(receipt) => {
+                    if receipt.request.record.author != author_iri {
+                        return Err("Pending property belongs to another identity".into());
+                    }
+                    (
+                        receipt.request.session,
+                        crate::panes::GraphId(receipt.request.graph),
+                        receipt
+                            .request
+                            .record
+                            .entity
+                            .parse()
+                            .map_err(|_| "Invalid recovery entity")?,
+                        receipt
+                            .manifest
+                            .ok_or("Pending property manifest unavailable")?,
+                        receipt.statement_id.clone(),
+                        receipt.assertion.clone(),
+                        false,
+                        receipt.withdrawal.as_ref().is_some_and(|w| !w.saved),
+                    )
+                },
+                RecoveryItem::Result(receipt) => (
+                    receipt.request.session,
+                    crate::panes::GraphId(receipt.request.graph),
+                    receipt.request.entity,
+                    receipt.request.manifest,
+                    receipt.statement_id.clone(),
+                    receipt.assertion.clone(),
+                    true,
+                    false,
+                ),
+            };
+        if session != *self.session_id.as_uuid() {
+            return Err("Pending save belongs to another session".into());
+        }
+        let missing = statement.as_ref().is_some_and(|id| {
+            self.graph_runtimes
+                .get(graph_id)
+                .is_none_or(|runtime| runtime.canvas.graph().find_assertion(id).is_none())
+        });
+        if missing {
+            let (work, bytes) =
+                research_record_graph::attachment_reservation(result_kind, &author_iri, manifest);
+            self.structured_scope_reserved(work, bytes)?;
+        }
+        let directory = self.session_dir();
+        let settings = self.research_search.preferences.records.clone();
+        let guard = crate::host_journal::AuthorRestore::enter(self.journal.clone(), author.clone());
+        let runtime = self
+            .graph_runtimes
+            .get_mut(graph_id)
+            .ok_or("Pending graph unavailable")?;
+        if runtime.session != Some(self.session_id)
+            || !runtime.persistence.owns_directory(&directory)
+            || runtime.canvas.graph().resource(entity).is_none()
+        {
+            return Err("Pending graph or writer lease unavailable".into());
+        }
+        let mut budget = research_record_graph::Budget::new(&settings);
+        let candidates = if result_kind {
+            research_record_graph::result_bindings_limited(runtime.canvas.graph(), &mut budget)?
+        } else {
+            research_record_graph::bindings_limited(runtime.canvas.graph(), true, &mut budget)?
+        };
+        let mut same = candidates
+            .into_iter()
+            .filter(|candidate| candidate.entity == entity && candidate.manifest == manifest);
+        let existing = same.next();
+        if same.next().is_some() {
+            return Err("Pending graph binding is ambiguous".into());
+        }
+        let (binding, assertion, withdrawn) = if let Some(existing) = existing {
+            if existing.author != author_iri
+                || statement
+                    .as_ref()
+                    .is_some_and(|id| id != &existing.statement_id)
+            {
+                return Err("Pending graph binding differs from receipt".into());
+            }
+            let actual = research_record_graph::assertion_for(runtime.canvas.graph(), &existing)?;
+            let recorded = assertion.unwrap_or_else(|| actual.clone());
+            if withdrawing && existing.withdrawn {
+                let mut a = actual.clone();
+                let mut b = recorded.clone();
+                if let Some(object) = a.as_object_mut() {
+                    object.remove("withdrawn");
+                }
+                if let Some(object) = b.as_object_mut() {
+                    object.remove("withdrawn");
+                }
+                if a != b {
+                    return Err("Withdrawn assertion differs from its receipt".into());
+                }
+            } else if actual != recorded || existing.withdrawn {
+                return Err("Pending assertion differs from its receipt".into());
+            }
+            let binding = Binding {
+                graph: graph_id,
+                entity,
+                statement_id: existing.statement_id,
+                manifest,
+            };
+            (binding, recorded, existing.withdrawn)
+        } else {
+            let statement_id =
+                statement.ok_or("This unbound deposit has no durable assertion; set it aside")?;
+            let assertion = assertion.ok_or("Pending assertion content unavailable")?;
+            let expected = GraphBinding {
+                entity,
+                statement_id: statement_id.clone(),
+                manifest,
+                withdrawn: false,
+                author: author_iri,
+            };
+            let mut outcome = Err("Recovery graph mutation did not run".to_owned());
+            runtime.canvas.ingest_graph(|graph| {
+                outcome = graph.write_as(author, |graph| {
+                    research_record_graph::restore(
+                        graph,
+                        &expected,
+                        &assertion,
+                        result_kind,
+                        &settings,
+                    )
+                });
+                outcome.is_ok()
+            });
+            outcome?;
+            (
+                Binding {
+                    graph: graph_id,
+                    entity,
+                    statement_id,
+                    manifest,
+                },
+                assertion,
+                false,
+            )
+        };
+        drop(guard);
+        Ok((binding, assertion, withdrawn))
+    }
+}
diff --git a/src/app/research_record_completion.rs b/src/app/research_record_completion.rs
new file mode 100644
index 00000000..da629683
--- /dev/null
+++ b/src/app/research_record_completion.rs
@@ -0,0 +1,496 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::App;
+use crate::action::Effect;
+use crate::research_records::{Binding, Job, JobResult, PendingChoice, SavedResultChoice};
+impl App {
+    pub(crate) fn structured_completed(&mut self, response: JobResult) -> Vec<Effect> {
+        if !self.structured_response_current(&response) {
+            return vec![];
+        }
+        match response {
+            JobResult::OpenSource {
+                generation,
+                source,
+                version,
+                result,
+                ..
+            } => {
+                let controller = &self.research_search.structured.controller;
+                if controller.result_generation != Some(generation)
+                    || !controller.result.as_ref().is_some_and(|held| {
+                        held.snapshot
+                            .sources
+                            .iter()
+                            .any(|item| item.source == source && item.version == version)
+                    })
+                {
+                    return self.structured_error("Frozen source changed");
+                }
+                let target = match result {
+                    Ok(target) => target,
+                    Err(error) => return self.structured_error(error),
+                };
+                let controller = &mut self.research_search.structured.controller;
+                controller.pending = None;
+                controller.busy = false;
+                return self.structured_open_verified(target);
+            },
+            JobResult::OpenEvidence {
+                generation,
+                binding,
+                record,
+                result,
+                ..
+            } => {
+                let controller = &self.research_search.structured.controller;
+                let still_current = match generation {
+                    Some(generation) => {
+                        controller.result_generation == Some(generation)
+                            && controller.frozen_record(&record.id) == Some(&record)
+                    },
+                    None => controller
+                        .inspected
+                        .as_ref()
+                        .is_some_and(|(held, value)| held == &binding && value == &record),
+                };
+                if !still_current {
+                    return self.structured_error("Property evidence changed");
+                }
+                let target = match result {
+                    Ok(target) => target,
+                    Err(error) => return self.structured_error(error),
+                };
+                let controller = &mut self.research_search.structured.controller;
+                controller.pending = None;
+                controller.busy = false;
+                return self.structured_open_verified(target);
+            },
+            JobResult::Deposit { request, result } => {
+                let manifest = match result {
+                    Ok(id) => id,
+                    Err(error) => return self.structured_error(error),
+                };
+                let (binding, assertion) = match self.structured_attach_binding(
+                    request.property.graph,
+                    request.property.entity,
+                    manifest,
+                    false,
+                    &request.author,
+                ) {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let scope = match self.structured_after_commit(&request.scope, binding.graph) {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                self.clear_structured_projection();
+                return self.structured_submit(Job::MarkProperty {
+                    request,
+                    scope,
+                    binding,
+                    assertion,
+                });
+            },
+            JobResult::Query {
+                request,
+                result,
+                manifest,
+            } => {
+                let value = match result {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let manifest = match manifest {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                if let (Some(manifest), Some((graph, entity))) = (manifest, request.result_anchor) {
+                    let author = match self.structured_author_identity() {
+                        Ok(value) => value.asserter_iri(),
+                        Err(error) => return self.structured_error(error),
+                    };
+                    let (binding, assertion) = match self
+                        .structured_attach_binding(graph, entity, manifest, true, &author)
+                    {
+                        Ok(value) => value,
+                        Err(error) => return self.structured_error(error),
+                    };
+                    let scope = match self.structured_after_commit(&request.scope, graph) {
+                        Ok(value) => value,
+                        Err(error) => return self.structured_error(error),
+                    };
+                    self.clear_structured_projection();
+                    return self.structured_submit(Job::MarkResult {
+                        request,
+                        scope,
+                        binding,
+                        assertion,
+                        value,
+                    });
+                }
+                let controller = &mut self.research_search.structured.controller;
+                if let Err(error) = controller.install_result(value, request.scope.clone()) {
+                    return self.structured_error(error);
+                }
+                controller.accepted = Some(request);
+                controller.error = Some(
+                    "This result could not be saved because no graph resource is available".into(),
+                );
+            },
+            JobResult::Inspect {
+                scope,
+                binding,
+                result,
+                ..
+            } => {
+                let value = match result {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let mut owners = scope
+                    .owner_bindings
+                    .iter()
+                    .filter(|item| item.binding == binding && item.author == value.author);
+                let Some(owner) = owners.next() else {
+                    return self.structured_error("Property attribution changed");
+                };
+                if owners.next().is_some() {
+                    return self.structured_error("Property attribution is ambiguous");
+                }
+                let withdrawn = owner.withdrawn;
+                let controller = &mut self.research_search.structured.controller;
+                controller.inspected = Some((binding, value));
+                controller.inspected_withdrawn = Some(withdrawn);
+                controller.view_scope = Some(scope);
+                controller.error = None;
+            },
+            JobResult::Replay { scope, result, .. } => {
+                let value = match result {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let controller = &mut self.research_search.structured.controller;
+                if let Err(error) = controller.install_result(value, scope) {
+                    return self.structured_error(error);
+                }
+                controller.result_historical = true;
+                controller.accepted = None;
+                controller.error = None;
+            },
+            JobResult::ConfirmProperty {
+                scope,
+                binding,
+                result,
+                ..
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                let controller = &mut self.research_search.structured.controller;
+                controller.view_scope = Some(scope);
+                controller.error = None;
+                controller.inspected = None;
+                controller.inspected_withdrawn = None;
+                controller.saved_result = None;
+                let _ = binding;
+            },
+            JobResult::ConfirmResult {
+                mut request,
+                scope,
+                binding,
+                value,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                request.scope = scope.clone();
+                let controller = &mut self.research_search.structured.controller;
+                if let Err(error) = controller.install_result(value, scope) {
+                    return self.structured_error(error);
+                }
+                controller.accepted = Some(request);
+                controller.saved_result = Some(binding.manifest);
+                controller.error = None;
+            },
+            JobResult::MarkProperty {
+                request,
+                scope,
+                binding,
+                assertion,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_check_assertion_author(&assertion) {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_assertion_matches(&binding, &assertion, false) {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_save_graph(binding.graph) {
+                    return self.structured_error(error);
+                }
+                if self.structured_scope().ok().as_ref() != Some(&scope) {
+                    return self.structured_error("Structured scope changed during save");
+                }
+                return self.structured_submit(Job::ConfirmProperty {
+                    request,
+                    scope,
+                    binding,
+                });
+            },
+            JobResult::MarkResult {
+                request,
+                scope,
+                binding,
+                assertion,
+                value,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_check_assertion_author(&assertion) {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_assertion_matches(&binding, &assertion, true) {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_save_graph(binding.graph) {
+                    return self.structured_error(error);
+                }
+                if self.structured_scope().ok().as_ref() != Some(&scope) {
+                    return self.structured_error("Structured scope changed during save");
+                }
+                return self.structured_submit(Job::ConfirmResult {
+                    request,
+                    scope,
+                    binding,
+                    value,
+                });
+            },
+            JobResult::PrepareWithdrawal {
+                id,
+                scope,
+                binding,
+                nonce,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                if !self
+                    .structured_has_binding(&binding, false)
+                    .unwrap_or(false)
+                {
+                    return self.structured_error("Property binding changed before withdrawal");
+                }
+                if let Err(error) = self.structured_commit_withdrawal(&binding) {
+                    return self.structured_error(error);
+                }
+                let after = match self.structured_after_commit(&scope, binding.graph) {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                self.clear_structured_projection();
+                return self.structured_submit(Job::ConfirmWithdrawal {
+                    id,
+                    scope: after,
+                    binding,
+                    nonce,
+                });
+            },
+            JobResult::ConfirmWithdrawal { scope, result, .. } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                let controller = &mut self.research_search.structured.controller;
+                controller.view_scope = Some(scope);
+                controller.error = None;
+            },
+            JobResult::Recovery { scope, result, .. } => {
+                let items = match result {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let full_scope = self.structured_scope().ok();
+                let mut choices = Vec::new();
+                for item in &items {
+                    let (kind, graph, manifest, attached, withdrawal) = match item {
+                        crate::trail_memory::record_actor::RecoveryItem::Property(receipt) => (
+                            "Property",
+                            receipt.request.graph,
+                            receipt.manifest,
+                            receipt.statement_id.is_some(),
+                            receipt.withdrawal.as_ref().is_some_and(|w| !w.saved),
+                        ),
+                        crate::trail_memory::record_actor::RecoveryItem::Result(receipt) => (
+                            "Result",
+                            receipt.request.graph,
+                            Some(receipt.request.manifest),
+                            receipt.statement_id.is_some(),
+                            false,
+                        ),
+                    };
+                    let live = full_scope.as_ref().map(|full| {
+                        manifest.is_some_and(|manifest| {
+                            full.graph_manifests
+                                .contains(&(crate::panes::GraphId(graph), manifest))
+                        })
+                    });
+                    let orphan = !attached && live != Some(true) && !withdrawal;
+                    let status = if orphan {
+                        if live.is_none() {
+                            "Deposit unverified; adjust graph limits to verify"
+                        } else {
+                            "Unbound deposit"
+                        }
+                    } else if live.is_none() {
+                        "Pending save; adjust graph limits to retry"
+                    } else if withdrawal {
+                        "Withdrawal awaiting save"
+                    } else {
+                        "Attachment awaiting save"
+                    };
+                    choices.push(PendingChoice {
+                        nonce: item.nonce(),
+                        kind: kind.into(),
+                        status: status.into(),
+                        orphan,
+                    });
+                }
+                let controller = &mut self.research_search.structured.controller;
+                controller.recovery = choices;
+                controller.recovery_items = items;
+                controller.recovery_scope = Some(scope);
+                controller.error = None;
+            },
+            JobResult::Discover {
+                scope,
+                bindings,
+                history,
+                result,
+                ..
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                let controller = &mut self.research_search.structured.controller;
+                if history {
+                    controller.history_choices = bindings;
+                    controller.history_scope = Some(scope);
+                } else {
+                    controller.saved_choices = bindings
+                        .into_iter()
+                        .map(|binding| SavedResultChoice { binding })
+                        .collect();
+                    controller.discovery_scope = Some(scope);
+                }
+                controller.error = None;
+            },
+            JobResult::Reconcile {
+                id,
+                scope,
+                item,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                let (binding, assertion, withdrawn) = match self.structured_recover_assertion(&item)
+                {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                let withdrawal = matches!(&item, crate::trail_memory::record_actor::RecoveryItem::Property(receipt) if receipt.withdrawal.as_ref().is_some_and(|w| !w.saved));
+                if withdrawal {
+                    let saved = if withdrawn {
+                        self.structured_save_graph(binding.graph)
+                    } else {
+                        self.structured_commit_withdrawal(&binding)
+                    };
+                    if let Err(error) = saved {
+                        return self.structured_error(error);
+                    }
+                    let after = match self.structured_after_commit(&scope, binding.graph) {
+                        Ok(value) => value,
+                        Err(error) => return self.structured_error(error),
+                    };
+                    self.clear_structured_projection();
+                    return self.structured_submit(Job::RecoveryAck {
+                        id,
+                        scope: after,
+                        item,
+                        binding,
+                    });
+                }
+                let after = match self.structured_after_commit(&scope, binding.graph) {
+                    Ok(value) => value,
+                    Err(error) => return self.structured_error(error),
+                };
+                self.clear_structured_projection();
+                return self.structured_submit(Job::RecoveryMark {
+                    id,
+                    scope: after,
+                    item,
+                    binding,
+                    assertion,
+                });
+            },
+            JobResult::RecoveryMark {
+                id,
+                scope,
+                item,
+                binding,
+                assertion,
+                result,
+            } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_check_assertion_author(&assertion) {
+                    return self.structured_error(error);
+                }
+                let result_kind = matches!(
+                    &item,
+                    crate::trail_memory::record_actor::RecoveryItem::Result(_)
+                );
+                if let Err(error) =
+                    self.structured_assertion_matches(&binding, &assertion, result_kind)
+                {
+                    return self.structured_error(error);
+                }
+                if let Err(error) = self.structured_save_graph(binding.graph) {
+                    return self.structured_error(error);
+                }
+                if self.structured_scope().ok().as_ref() != Some(&scope) {
+                    return self.structured_error("Structured scope changed during recovery save");
+                }
+                return self.structured_submit(Job::RecoveryAck {
+                    id,
+                    scope,
+                    item,
+                    binding,
+                });
+            },
+            JobResult::Abandon { result, .. } | JobResult::RecoveryAck { result, .. } => {
+                if let Err(error) = result {
+                    return self.structured_error(error);
+                }
+                return self.structured_refresh_recovery();
+            },
+        }
+        let controller = &mut self.research_search.structured.controller;
+        controller.pending = None;
+        controller.busy = false;
+        if self.research_search.structured.indexed_generation != controller.result_generation {
+            self.clear_structured_index();
+        }
+        self.recompute_omnibar_suggestions();
+        vec![Effect::Redraw]
+    }
+}
diff --git a/src/app/research_record_index.rs b/src/app/research_record_index.rs
new file mode 100644
index 00000000..8c90037b
--- /dev/null
+++ b/src/app/research_record_index.rs
@@ -0,0 +1,81 @@
+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+//! Checked once-per-result identity index for bounded presentation.
+use super::research_record_owner::Controller;
+use crate::research_records::{Binding, ScopeToken};
+use eidetic::records::{LifecycleState, RecordResult};
+use std::collections::HashMap;
+
+impl Controller {
+    pub(super) fn install_result(
+        &mut self,
+        result: RecordResult,
+        scope: ScopeToken,
+    ) -> Result<(), String> {
+        self.result = None;
+        self.result_generation = None;
+        self.result_historical = false;
+        self.record_index.clear();
+        let mut observations = HashMap::new();
+        let mut owners = HashMap::new();
+        for owner in &scope.owner_bindings {
+            let key = (
+                *owner.binding.graph.as_uuid(),
+                owner.binding.statement_id.as_str(),
+            );
+            if owners.insert(key, owner).is_some() {
+                return Err("Ambiguous frozen graph owner".into());
+            }
+        }
+        for observation in &result.snapshot.lifecycle {
+            if observation.state != LifecycleState::Active
+                || observations
+                    .insert(observation.record_id.as_str(), observation)
+                    .is_some()
+            {
+                return Err("Ambiguous frozen record lifecycle".into());
+            }
+        }
+        let mut index = HashMap::new();
+        for (position, record) in result.snapshot.records.iter().enumerate() {
+            let observation = observations
+                .remove(record.id.as_str())
+                .ok_or("Frozen record lifecycle unavailable")?;
+            let (session, graph, statement_id, manifest) =
+                crate::research_records_worker::parse_lifecycle(&observation.lifecycle_ref)?;
+            if session != *scope.context.session.as_uuid() {
+                return Err("Frozen record belongs to another session".into());
+            }
+            let entity = record
+                .entity
+                .parse()
+                .map_err(|_| "Invalid frozen record entity")?;
+            let binding = Binding {
+                graph: crate::panes::GraphId(graph),
+                entity,
+                statement_id,
+                manifest,
+            };
+            if !owners
+                .get(&(graph, binding.statement_id.as_str()))
+                .is_some_and(|owner| owner.binding == binding && owner.author == record.author)
+            {
+                return Err("Frozen record owner is unavailable".into());
+            }
+            if index
+                .insert(record.id.clone(), (position, binding))
+                .is_some()
+            {
+                return Err("Ambiguous frozen record identity".into());
+            }
+        }
+        if !observations.is_empty() {
+            return Err("Frozen lifecycle has no record".into());
+        }
+        self.result = Some(result);
+        self.record_index = index;
+        self.result_generation = Some(uuid::Uuid::new_v4());
+        self.view_scope = Some(scope);
+        Ok(())
+    }
+}
diff --git a/src/app/research_record_integration_tests.rs b/src/app/research_record_integration_tests.rs
