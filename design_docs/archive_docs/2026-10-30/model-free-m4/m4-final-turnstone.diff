+    },
+    RecoveryMark {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        item: crate::trail_memory::record_actor::RecoveryItem,
+        binding: Binding,
+        assertion: serde_json::Value,
+        result: Result<(), crate::research_storage::SourceReadError>,
+    },
+    RecoveryAck {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        item: crate::trail_memory::record_actor::RecoveryItem,
+        binding: Binding,
+        result: Result<(), crate::research_storage::SourceReadError>,
+    },
+    Abandon {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        nonce: uuid::Uuid,
+        result: Result<(), crate::research_storage::SourceReadError>,
+    },
+    Discover {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        bindings: Vec<Binding>,
+        history: bool,
+        result: Result<(), crate::research_storage::SourceReadError>,
+    },
+    OpenSource {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        generation: uuid::Uuid,
+        source: eidetic::models::recall::RecallSourceId,
+        version: String,
+        result: Result<Target, crate::research_storage::SourceReadError>,
+    },
+    OpenEvidence {
+        id: uuid::Uuid,
+        scope: ScopeToken,
+        generation: Option<uuid::Uuid>,
+        binding: Binding,
+        record: PropertyRecordV1,
+        result: Result<Target, crate::research_storage::SourceReadError>,
+    },
+}
