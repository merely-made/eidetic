+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::*;
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn run(
+    context: crate::research::Context,
+    selected: Option<Vec<crate::saved_sources::Key>>,
+    max_chars: Option<usize>,
+    max_metadata_chars: Option<usize>,
+    budget: Option<crate::research_storage::SharedReadBudget>,
+    reply: std::sync::mpsc::SyncSender<Result<Vec<crate::saved_sources::Entry>, String>>,
+    state: &mut Option<(FjallStore, BrowsingMemory)>,
+    sealed_store: &mut Option<FjallStore>,
+    custody: &Option<SourceCustody>,
+    current_dir: &Path,
+    current_capture_generation: uuid::Uuid,
+    memory_error: &Option<String>,
+    sealed_error: &Option<String>,
+    limits: &Result<crate::research_storage::StorageLimits, String>,
+) {
+    let custody_epoch = custody.as_ref().and_then(SourceCustody::snapshot);
+    let valid = context.generation == current_capture_generation
+        && inference_owner(&current_dir).ok()
+            == Some(format!("turnstone/{}", context.session.as_uuid()))
+        && context
+            .admissions
+            .iter()
+            .all(|a| a.key.session == context.session)
+        && selected.as_ref().is_none_or(|selected| {
+            selected.iter().all(|key| {
+                context
+                    .admissions
+                    .iter()
+                    .any(|admission| &admission.key == key)
+            })
+        });
+    let mut result = if !valid {
+        Err("The saved-source owner belongs to another session opening.".into())
+    } else if custody_epoch.is_none() {
+        Err("Unlock the profile to read private saved sources.".into())
+    } else if let Some(error) = &sealed_error {
+        Err(error.clone())
+    } else {
+        state
+            .as_mut()
+            .map(|(store, _)| {
+                let budget = budget.or_else(|| limits.as_ref().ok().map(|limits| limits.budget()));
+                let budget = budget.ok_or_else(|| {
+                    limits
+                        .as_ref()
+                        .err()
+                        .cloned()
+                        .unwrap_or_else(|| "Storage limits unavailable".into())
+                })?;
+                let mut legacy = crate::research_storage::BudgetStore {
+                    store,
+                    budget: budget.clone(),
+                };
+                let mut sealed =
+                    sealed_store
+                        .as_mut()
+                        .map(|store| crate::research_storage::BudgetStore {
+                            store,
+                            budget: budget.clone(),
+                        });
+                let mut seen = std::collections::HashSet::new();
+                let admissions = context
+                    .admissions
+                    .iter()
+                    .filter(|admission| {
+                        selected
+                            .as_ref()
+                            .is_none_or(|keys| keys.contains(&admission.key))
+                            && (max_chars.is_none() || seen.insert(admission.key.clone()))
+                    })
+                    .cloned()
+                    .collect::<Vec<_>>();
+                saved_sources::load_with_sealed_bounded(
+                    &mut legacy,
+                    sealed.as_mut().map(|s| s as &mut dyn eidetic::Store),
+                    custody
+                        .as_ref()
+                        .map(|v| v.sealer.as_ref() as &dyn eidetic::PayloadSealer),
+                    &admissions,
+                    max_chars,
+                    max_metadata_chars,
+                )
+            })
+            .ok_or_else(|| {
+                memory_error
+                    .clone()
+                    .unwrap_or_else(|| "The session evidence store is unavailable.".to_string())
+            })
+            .and_then(|result| result)
+    };
+    if custody_epoch.is_some()
+        && !custody
+            .as_ref()
+            .is_some_and(|binding| binding.remains_current(custody_epoch))
+    {
+        result = Err("Profile custody changed while loading private saved sources.".into());
+    }
+    let _ = reply.send(result);
+}
