+// Copyright 2026 Mark Alan Boykin
+// SPDX-License-Identifier: MPL-2.0
+use super::*;
+
+pub(super) fn run(
+    directory: &Path,
+    limits: &Result<crate::research_storage::StorageLimits, String>,
+) -> (Option<FjallStore>, Option<String>) {
+    let result = limits.as_ref().map_err(Clone::clone).and_then(|limits| {
+        FjallStore::open_with_limits(sealed_memory_dir(directory), limits.owner())
+            .map_err(|error| format!("open sealed session store: {error}"))
+    });
+    match result {
+        Ok(store) => (Some(store), None),
+        Err(error) => (None, Some(error)),
+    }
+}
