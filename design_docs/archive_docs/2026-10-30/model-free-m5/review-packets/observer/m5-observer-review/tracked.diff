+/// Extract a saved result identity without accepting a stale or foreign observation.
+pub(crate) fn observed_saved_result(value: &serde_json::Value, session: &str) -> Result<String, String> {
+    if value["schema"] != "turnstone.structured-observation/v1"
+        || value["session"].as_str() != Some(session)
+        || value["historical"] != false || value["busy"] != false {
+        return Err("saved result observation is not current for this session".into());
+    }
+    let saved = value["saved_manifest"].as_str().ok_or("saved result missing")?;
+    if saved.is_empty() || value["content_manifest"].as_str() != Some(saved) {
+        return Err("saved result identity mismatch".into());
+    }
+    Ok(saved.to_string())
+}
+
+/// Extract one saved capture identity from a current-session observation.
+pub(crate) fn observed_capture_manifest(value: &serde_json::Value, session: &str, ordinal: u64) -> Result<String, String> {
+    let values = value.as_array().ok_or("capture observation is not an array")?;
+    let matches: Vec<_> = values.iter().filter(|item| item["session"].as_str() == Some(session)
+        && item["ordinal"].as_u64() == Some(ordinal) && item["phase"] == "saved").collect();
+    let [item] = matches.as_slice() else { return Err("capture observation absent or ambiguous".into()); };
+    let manifest = item["stored"]["annotation_manifest"].as_str().ok_or("capture manifest missing")?;
+    if manifest.is_empty() { return Err("empty capture manifest".into()); }
+    Ok(manifest.to_string())
+}
+
+/// Find one row by exact displayed label, falling back to a unique substring.
+/// The caller must still navigate to the row through the ordinary input seam.
+pub(crate) fn suggestion_target(labels: &[String], label: &str) -> Result<usize, String> {
+    let exact: Vec<_> = labels
+        .iter()
+        .enumerate()
+        .filter(|(_, value)| value.as_str() == label || value.strip_prefix("› ") == Some(label))
+        .map(|(index, _)| index)
+        .collect();
+    let matches = if exact.is_empty() {
+        labels
+            .iter()
+            .enumerate()
+            .filter(|(_, value)| value.contains(label))
+            .map(|(index, _)| index)
+            .collect::<Vec<_>>()
+    } else {
+        exact
+    };
+    match matches.as_slice() {
+        [target] => Ok(*target),
+        _ => Err(format!("suggestion is absent or ambiguous: {label}")),
+    }
+}
