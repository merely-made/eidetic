# Draft ordinary Redshank controls; the source is a generated half-second tone
# copied into the isolated fixture directory, which is removed before reopen.
open file:///m5/run/fixture-source/episode.mp3
settle 60
assert pane turnstone.redshank-episode
click role:button Add text note
settle 20
click role:textbox
input-text M5 authored Redshank note
click role:button Save text note
settle 60
capture redshank_note_private
click-note-member
assert-no-action Retain selected Redshank note
capture redshank_private_action_absent
click role:button More actions for note at 0:00
click role:button Make shareable: note at 0:00
settle 60
capture redshank_note_shareable
click-note-member
assert snap actions ~ Retain selected Redshank note
act Retain selected Redshank note
settle 60
act Search saved sources
type M5 authored Redshank note
wait-saved-sources 600
wait-research-search 600
assert snap suggestions ~ Note:
record-saved-sources redshank_note_admitted
capture redshank_note_admitted
